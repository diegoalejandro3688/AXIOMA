{
  "name": "@axioma/backend",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --ext .ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "verify:curriculum-topic-count": "tsx scripts/verify-curriculum-topic-count.ts",
    "verify:auth-gate": "tsx scripts/verify-auth-gate.ts",
    "verify:privacy-gate": "tsx scripts/verify-privacy-gate.ts",
    "verify:analytics-gate": "tsx scripts/verify-analytics-gate.ts",
    "verify:observability-gate": "tsx scripts/verify-observability-gate.ts",
    "cli:recover-account": "node dist/cli/recover-account.js",
    "db:up": "docker compose -f ../../docker-compose.yml up -d",
    "db:down": "docker compose -f ../../docker-compose.yml down"
  },
  "dependencies": {
    "@axioma/contracts": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "^10.4.15",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/schedule": "6.1.3",
    "@nestjs/throttler": "6.5.0",
    "@prisma/adapter-pg": "7.9.1",
    "@prisma/client": "7.9.1",
    "dotenv": "17.4.2",
    "firebase-admin": "14.2.0",
    "pg": "8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/pg": "8.20.0",
    "prisma": "7.9.1",
    "tsx": "4.23.1",
    "typescript": "^5.7.2"
  }
}
