generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Dominio EDUCATION. Andamiaje mínimo del árbol de temas curriculares --
/// NO es el catálogo PAES completo. Ver docs/adr/0003-postgres-prisma-foundation.md.
model CurriculumTopic {
  id       String  @id @default(uuid()) @db.Uuid
  code     String  @unique
  name     String
  order    Int
  parentId String? @map("parent_id") @db.Uuid

  parent   CurriculumTopic?  @relation("CurriculumTopicToParent", fields: [parentId], references: [id], onDelete: Restrict)
  children CurriculumTopic[] @relation("CurriculumTopicToParent")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("curriculum_topic")
}

/// Dominio AUTH. Subconjunto mínimo del Data Model Bloque 5 -- ver
/// docs/adr/0004-identity-authentication-foundation.md. Firebase es proveedor
/// de identidad; estas tablas son la única autoridad interna sobre la cuenta.
enum AccountStatus {
  PENDING // correo no verificado, acceso limitado
  ACTIVE // correo verificado
  DELETION_PENDING
  CLOSED

  @@map("account_status")
}

model Account {
  id                  String        @id @default(uuid()) @db.Uuid
  status              AccountStatus @default(PENDING)
  sessionVersion      Int           @default(1) @map("session_version")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  lastAuthenticatedAt DateTime?     @map("last_authenticated_at")
  deletionRequestedAt DateTime?     @map("deletion_requested_at")
  closedAt            DateTime?     @map("closed_at")

  identities AuthIdentity[]
  sessions   AuthSession[]

  @@map("account")
}

/// Vínculo con el UID de Firebase. Firebase ya fusiona métodos de acceso
/// (correo, Google, Apple) bajo un mismo UID cuando el usuario los vincula
/// explícitamente de su lado -- Axioma nunca fusiona dos UID distintos.
model AuthIdentity {
  id               String    @id @default(uuid()) @db.Uuid
  accountId        String    @map("account_id") @db.Uuid
  providerCode     String    @default("firebase") @map("provider_code")
  providerSubject  String    @map("provider_subject")
  emailNormalized  String    @map("email_normalized")
  emailVerifiedAt  DateTime? @map("email_verified_at")
  linkedAt         DateTime  @default(now()) @map("linked_at")
  lastUsedAt       DateTime? @map("last_used_at")
  unlinkedAt       DateTime? @map("unlinked_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([providerCode, providerSubject])
  @@index([emailNormalized])
  @@map("auth_identity")
}

/// Sesión propia y revocable, independiente de la validez técnica del
/// idToken de Firebase. El AuthGuard valida esta fila específica -- no
/// "cualquier sesión activa de la cuenta".
model AuthSession {
  id             String    @id @default(uuid()) @db.Uuid
  accountId      String    @map("account_id") @db.Uuid
  sessionVersion Int       @map("session_version")
  createdAt      DateTime  @default(now()) @map("created_at")
  lastSeenAt     DateTime? @map("last_seen_at")
  expiresAt      DateTime  @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId])
  @@map("auth_session")
}

/// Dominio PRIVACY. Coordina la eliminación de cuenta -- hoy solo orquesta
/// AUTH (único dominio con datos personales); cuando existan más dominios
/// con datos propios, cada uno se coordina desde aquí, no desde AUTH.
/// Ver docs/adr/0005-privacy-foundation.md.
enum PrivacyRequestStatus {
  PENDING // dentro del plazo de 30 días, recuperable
  PROCESSING // el barrido ya empezó a ejecutar el cierre -- ya no es recuperable
  COMPLETED
  CANCELLED

  @@map("privacy_request_status")
}

model PrivacyRequest {
  id                  String               @id @default(uuid()) @db.Uuid
  accountId           String               @map("account_id") @db.Uuid
  status              PrivacyRequestStatus @default(PENDING)
  requestedAt         DateTime             @default(now()) @map("requested_at")
  scheduledFor        DateTime             @map("scheduled_for")
  /// Se fija la PRIMERA vez que entra a PROCESSING y no se sobrescribe en
  /// reintentos -- así "cuánto lleva atascada" se mide desde el intento
  /// original, no desde el último reintento. Ver docs/adr/0005.
  processingStartedAt DateTime?            @map("processing_started_at")
  completedAt         DateTime?            @map("completed_at")
  cancelledAt         DateTime?            @map("cancelled_at")

  @@index([accountId])
  @@index([status, scheduledFor])
  @@index([status, processingStartedAt])
  @@map("privacy_request")
}

/// Infraestructura COMPARTIDA de plataforma, no propiedad de ningún dominio --
/// ver docs/adr/0006-analytics-foundation.md. Cualquier dominio puede publicar
/// (AUTH y PRIVACY hoy); ANALYTICS es el primer consumidor, pero el diseño
/// admite consumidores futuros (Gamification, Progress, Recommendation...)
/// leyendo la misma tabla con su propio cursor/criterio.
enum OutboxEventStatus {
  PENDING
  PROCESSED
  FAILED

  @@map("outbox_event_status")
}

model OutboxEvent {
  id              String            @id @default(uuid()) @db.Uuid
  eventKey        String            @map("event_key")
  schemaVersion   String            @map("schema_version")
  sourceDomain    String            @map("source_domain")
  aggregateId     String?           @map("aggregate_id") @db.Uuid
  /// Versión del backend que publicó el evento (trazabilidad entre
  /// versiones) -- ver ADR-0006, ajuste 2. Best-effort: puede faltar si la
  /// variable de entorno no está configurada.
  producerVersion String?           @map("producer_version")
  occurredAt      DateTime          @map("occurred_at")
  payload         Json
  status          OutboxEventStatus @default(PENDING)
  attempts        Int               @default(0)
  lastError       String?           @map("last_error")
  createdAt       DateTime          @default(now()) @map("created_at")
  processedAt     DateTime?         @map("processed_at")

  @@index([status, createdAt])
  @@map("outbox_event")
}

/// Dominio ANALYTICS. Subconjunto mínimo del Bloque 19 del Data Model -- ver
/// docs/adr/0006-analytics-foundation.md. Analytics NUNCA escribe aquí
/// directamente desde otro dominio: solo el relay de ANALYTICS, consumiendo
/// OutboxEvent ya publicado. Sin FK a Account (mismo criterio que
/// PrivacyRequest): desacople de esquema entre dominios.
model AnalyticsEvent {
  id                String   @id @default(uuid()) @db.Uuid
  eventKey          String   @map("event_key")
  schemaVersion     String   @map("schema_version")
  sourceDomain      String   @map("source_domain")
  /// HMAC-SHA256(accountId) -- nunca el accountId crudo. Versión mínima de
  /// pseudonimización, no el analytics_actor completo del Data Model (sin
  /// rotación ni ciclo de vida propio) -- ver ADR-0006.
  analyticsActorRef String?  @map("analytics_actor_ref")
  producerVersion   String?  @map("producer_version")
  occurredAt        DateTime @map("occurred_at")
  receivedAt        DateTime @default(now()) @map("received_at")
  payload           Json
  /// = OutboxEvent.id -- evita duplicar el mismo evento si el relay reprocesa.
  idempotencyKey    String   @unique @map("idempotency_key")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([eventKey, occurredAt])
  @@map("analytics_event")
}
