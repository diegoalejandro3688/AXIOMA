generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Dominio EDUCATION. Andamiaje mínimo del árbol de temas curriculares --
/// NO es el catálogo PAES completo. Ver docs/adr/0003-postgres-prisma-foundation.md.
/// `subjectId` agregado en Bloque I (ADR-0012) -- inmutable una vez fijado,
/// aplicado por trigger `enforce_curriculum_topic_subject_consistency` (permite
/// solo la transición NULL -> valor del backfill, nunca un cambio posterior).
model CurriculumTopic {
  id        String  @id @default(uuid()) @db.Uuid
  code      String  @unique
  name      String
  order     Int
  parentId  String? @map("parent_id") @db.Uuid
  subjectId String  @map("subject_id") @db.Uuid

  subject  Subject           @relation(fields: [subjectId], references: [id], onDelete: Restrict)
  parent   CurriculumTopic?  @relation("CurriculumTopicToParent", fields: [parentId], references: [id], onDelete: Restrict)
  children CurriculumTopic[] @relation("CurriculumTopicToParent")

  learningResourceVersions LearningResourceVersion[]
  questionVersions         QuestionVersion[]
  topicProgress            CurriculumTopicProgress[]

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([subjectId])
  @@map("curriculum_topic")
}

/// Dominio EDUCATION, Bloque I (Vertical Slice M1) -- ver
/// docs/adr/0012-education-foundation.md. Categoría disciplinaria estable,
/// SIN versión propia (no es contenido, Data Model 8.11).
enum SubjectStatus {
  ACTIVE
  RETIRED

  @@map("subject_status")
}

model Subject {
  id           String        @id @default(uuid()) @db.Uuid
  subjectKey   String        @unique @map("subject_key")
  name         String
  shortName    String        @map("short_name")
  status       SubjectStatus @default(ACTIVE)
  displayOrder Int           @map("display_order")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  curriculumTopics  CurriculumTopic[]
  learningResources LearningResource[]
  questions         Question[]

  @@map("subject")
}

/// Ciclo de vida lógico compartido por las identidades de EDUCATION (recurso,
/// pregunta) -- independiente del `editorialStatus` de cada versión.
enum EducationLogicalStatus {
  ACTIVE
  RETIRED

  @@map("education_logical_status")
}

/// Estado editorial de una VERSIÓN -- ver Data Model 9.6/10.6. Solo
/// `PUBLISHED` es servible a estudiantes (ver EducationService).
enum EditorialStatus {
  DRAFT
  IN_REVIEW
  APPROVED
  PUBLISHED
  DEPRECATED
  ARCHIVED

  @@map("editorial_status")
}

/// Identidad estable de un recurso educativo (Data Model 9.4, subconjunto
/// mínimo). `primarySubjectId` es INMUTABLE una vez fijado (trigger
/// `enforce_learning_resource_subject_immutable`) -- ver ADR-0012.
/// `resourceType` acotado a 2 valores para M1 (no los 12 del Data Model).
enum LearningResourceType {
  LESSON
  CONCEPT_EXPLANATION

  @@map("learning_resource_type")
}

model LearningResource {
  id               String                 @id @default(uuid()) @db.Uuid
  resourceKey      String                 @unique @map("resource_key")
  primarySubjectId String                 @map("primary_subject_id") @db.Uuid
  resourceType     LearningResourceType   @map("resource_type")
  status           EducationLogicalStatus @default(ACTIVE)
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  primarySubject Subject                   @relation(fields: [primarySubjectId], references: [id], onDelete: Restrict)
  versions       LearningResourceVersion[]

  @@index([primarySubjectId])
  @@map("learning_resource")
}

/// Versión inmutable una vez publicada (Data Model 9.6, subconjunto mínimo).
/// `curriculumTopicId` vive AQUÍ (no en la identidad) -- es la clasificación
/// editorial fina, trazable por versión. Ver ADR-0012, invariante 1.
model LearningResourceVersion {
  id                 String          @id @default(uuid()) @db.Uuid
  learningResourceId String          @map("learning_resource_id") @db.Uuid
  curriculumTopicId  String          @map("curriculum_topic_id") @db.Uuid
  title              String
  /// `ResourceContentBlock[]` -- validado por Zod (packages/contracts), no por Postgres. Ver ADR-0012, punto 4.
  contentBlocks      Json            @map("content_blocks")
  editorialStatus    EditorialStatus @default(DRAFT) @map("editorial_status")
  publishedAt        DateTime?       @map("published_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  learningResource LearningResource @relation(fields: [learningResourceId], references: [id], onDelete: Restrict)
  curriculumTopic  CurriculumTopic  @relation(fields: [curriculumTopicId], references: [id], onDelete: Restrict)

  @@index([learningResourceId])
  @@index([curriculumTopicId])
  @@index([editorialStatus])
  @@map("learning_resource_version")
}

/// Identidad estable de una pregunta (Data Model 10.5, subconjunto mínimo).
/// `questionType` vive en la IDENTIDAD, no en la versión -- ver ADR-0012,
/// punto 4 de precisiones: cambiar de tipo no es una revisión editorial del
/// mismo concepto, es conceptualmente otra pregunta. M1 solo admite
/// SINGLE_CHOICE (PRD 11.6.1, Data Model DM-D124); habilitar otros tipos es
/// una decisión Nivel 2/3 futura y separada, no una extensión silenciosa del enum.
enum QuestionType {
  SINGLE_CHOICE

  @@map("question_type")
}

model Question {
  id               String                 @id @default(uuid()) @db.Uuid
  questionKey      String                 @unique @map("question_key")
  primarySubjectId String                 @map("primary_subject_id") @db.Uuid
  questionType     QuestionType           @default(SINGLE_CHOICE) @map("question_type")
  status           EducationLogicalStatus @default(ACTIVE)
  createdAt        DateTime               @default(now()) @map("created_at")
  updatedAt        DateTime               @updatedAt @map("updated_at")

  primarySubject Subject           @relation(fields: [primarySubjectId], references: [id], onDelete: Restrict)
  versions       QuestionVersion[]

  @@index([primarySubjectId])
  @@map("question")
}

/// Versión inmutable una vez publicada (Data Model 10.6, subconjunto mínimo).
/// `curriculumTopicId` vive aquí, igual que en LearningResourceVersion.
/// `explanationContent` absorbe `answer_explanation` (Data Model 10.12) como
/// campo, sin tabla ni tipificación por alternativa -- ver ADR-0012.
model QuestionVersion {
  id                 String          @id @default(uuid()) @db.Uuid
  questionId         String          @map("question_id") @db.Uuid
  curriculumTopicId  String          @map("curriculum_topic_id") @db.Uuid
  /// `ResourceContentBlock[]` (enunciado) -- validado por Zod.
  stemContent        Json            @map("stem_content")
  /// `ExplanationContentBlock[]` (subconjunto paragraph/formula/image) -- validado por Zod.
  explanationContent Json            @map("explanation_content")
  editorialStatus    EditorialStatus @default(DRAFT) @map("editorial_status")
  publishedAt        DateTime?       @map("published_at")
  createdAt          DateTime        @default(now()) @map("created_at")
  updatedAt          DateTime        @updatedAt @map("updated_at")

  question         Question          @relation(fields: [questionId], references: [id], onDelete: Restrict)
  curriculumTopic  CurriculumTopic   @relation(fields: [curriculumTopicId], references: [id], onDelete: Restrict)
  answerOptions    AnswerOption[]
  studentResponses StudentResponse[]

  @@index([questionId])
  @@index([curriculumTopicId])
  @@index([editorialStatus])
  @@map("question_version")
}

/// Absorbe `answer_key` (Data Model 10.10) como campo `isCorrect` -- sin tabla
/// propia, ver ADR-0012. `isCorrect` NUNCA se serializa hacia el cliente desde
/// los endpoints de EDUCATION (packages/contracts: `answerOptionPublicResponseSchema`
/// lo omite). Desde Bloque III (ADR-0014), PROGRESS lo revela -- pero solo en
/// la respuesta de `POST /progress/topics/:topicId/responses`, nunca en un
/// endpoint de EDUCATION.
model AnswerOption {
  id                String   @id @default(uuid()) @db.Uuid
  questionVersionId String   @map("question_version_id") @db.Uuid
  /// Bloque único (paragraph|formula) -- validado por Zod.
  content           Json
  displayOrder      Int      @map("display_order")
  isCorrect         Boolean  @default(false) @map("is_correct")
  createdAt         DateTime @default(now()) @map("created_at")

  questionVersion  QuestionVersion   @relation(fields: [questionVersionId], references: [id], onDelete: Cascade)
  studentResponses StudentResponse[]

  @@index([questionVersionId])
  @@map("answer_option")
}

/// Dominio PROGRESS (Bloque III, Vertical Slice M1) -- ver
/// docs/adr/0014-progress-foundation.md. Avance de CONTENIDO (PROGRESS-001):
/// NO evidencia académica ni dominio estimado (Data Model Bloques 12/13,
/// fuera de alcance). `NOT_STARTED` es la ausencia de fila -- nunca un valor
/// almacenado. Transición estrictamente monotónica hacia adelante, aplicada
/// por el trigger `enforce_curriculum_topic_progress_monotonic`.
enum TopicProgressStatus {
  IN_PROGRESS
  COMPLETED

  @@map("topic_progress_status")
}

model CurriculumTopicProgress {
  id                String              @id @default(uuid()) @db.Uuid
  accountId         String              @map("account_id") @db.Uuid
  curriculumTopicId String              @map("curriculum_topic_id") @db.Uuid
  status            TopicProgressStatus @default(IN_PROGRESS)
  startedAt         DateTime            @default(now()) @map("started_at")
  lastActivityAt    DateTime            @default(now()) @map("last_activity_at")
  completedAt       DateTime?           @map("completed_at")

  curriculumTopic CurriculumTopic @relation(fields: [curriculumTopicId], references: [id], onDelete: Restrict)

  @@unique([accountId, curriculumTopicId])
  @@index([accountId])
  @@map("curriculum_topic_progress")
}

/// Inmutable tras crearse -- aplicado por el trigger
/// `enforce_student_response_immutable` (ningún `UPDATE` permitido). La
/// idempotencia de negocio real es `(accountId, questionVersionId)`;
/// `operationId` es la clave de idempotencia de transporte (= id de la
/// operación en la cola offline del cliente, ADR-0011) -- ver ADR-0014, punto 4.
model StudentResponse {
  id                String   @id @default(uuid()) @db.Uuid
  accountId         String   @map("account_id") @db.Uuid
  questionVersionId String   @map("question_version_id") @db.Uuid
  answerOptionId    String   @map("answer_option_id") @db.Uuid
  isCorrect         Boolean  @map("is_correct")
  respondedAt       DateTime @default(now()) @map("responded_at")
  operationId       String   @unique @map("operation_id") @db.Uuid

  questionVersion QuestionVersion @relation(fields: [questionVersionId], references: [id], onDelete: Restrict)
  answerOption    AnswerOption    @relation(fields: [answerOptionId], references: [id], onDelete: Restrict)

  @@unique([accountId, questionVersionId])
  @@index([accountId])
  @@map("student_response")
}

/// Dominio AUTH. Subconjunto mínimo del Data Model Bloque 5 -- ver
/// docs/adr/0004-identity-authentication-foundation.md. Firebase es proveedor
/// de identidad; estas tablas son la única autoridad interna sobre la cuenta.
enum AccountStatus {
  PENDING // correo no verificado, acceso limitado
  ACTIVE // correo verificado
  DELETION_PENDING
  CLOSED

  @@map("account_status")
}

model Account {
  id                  String        @id @default(uuid()) @db.Uuid
  status              AccountStatus @default(PENDING)
  sessionVersion      Int           @default(1) @map("session_version")
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")
  lastAuthenticatedAt DateTime?     @map("last_authenticated_at")
  deletionRequestedAt DateTime?     @map("deletion_requested_at")
  closedAt            DateTime?     @map("closed_at")

  identities AuthIdentity[]
  sessions   AuthSession[]

  @@map("account")
}

/// Vínculo con el UID de Firebase. Firebase ya fusiona métodos de acceso
/// (correo, Google, Apple) bajo un mismo UID cuando el usuario los vincula
/// explícitamente de su lado -- Axioma nunca fusiona dos UID distintos.
model AuthIdentity {
  id              String    @id @default(uuid()) @db.Uuid
  accountId       String    @map("account_id") @db.Uuid
  providerCode    String    @default("firebase") @map("provider_code")
  providerSubject String    @map("provider_subject")
  emailNormalized String    @map("email_normalized")
  emailVerifiedAt DateTime? @map("email_verified_at")
  linkedAt        DateTime  @default(now()) @map("linked_at")
  lastUsedAt      DateTime? @map("last_used_at")
  unlinkedAt      DateTime? @map("unlinked_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@unique([providerCode, providerSubject])
  @@index([emailNormalized])
  @@map("auth_identity")
}

/// Sesión propia y revocable, independiente de la validez técnica del
/// idToken de Firebase. El AuthGuard valida esta fila específica -- no
/// "cualquier sesión activa de la cuenta".
model AuthSession {
  id             String    @id @default(uuid()) @db.Uuid
  accountId      String    @map("account_id") @db.Uuid
  sessionVersion Int       @map("session_version")
  createdAt      DateTime  @default(now()) @map("created_at")
  lastSeenAt     DateTime? @map("last_seen_at")
  expiresAt      DateTime  @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")

  account Account @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([accountId])
  @@map("auth_session")
}

/// Dominio PRIVACY. Coordina la eliminación de cuenta -- hoy solo orquesta
/// AUTH (único dominio con datos personales); cuando existan más dominios
/// con datos propios, cada uno se coordina desde aquí, no desde AUTH.
/// Ver docs/adr/0005-privacy-foundation.md.
enum PrivacyRequestStatus {
  PENDING // dentro del plazo de 30 días, recuperable
  PROCESSING // el barrido ya empezó a ejecutar el cierre -- ya no es recuperable
  COMPLETED
  CANCELLED

  @@map("privacy_request_status")
}

model PrivacyRequest {
  id                  String               @id @default(uuid()) @db.Uuid
  accountId           String               @map("account_id") @db.Uuid
  status              PrivacyRequestStatus @default(PENDING)
  requestedAt         DateTime             @default(now()) @map("requested_at")
  scheduledFor        DateTime             @map("scheduled_for")
  /// Se fija la PRIMERA vez que entra a PROCESSING y no se sobrescribe en
  /// reintentos -- así "cuánto lleva atascada" se mide desde el intento
  /// original, no desde el último reintento. Ver docs/adr/0005.
  processingStartedAt DateTime?            @map("processing_started_at")
  completedAt         DateTime?            @map("completed_at")
  cancelledAt         DateTime?            @map("cancelled_at")

  @@index([accountId])
  @@index([status, scheduledFor])
  @@index([status, processingStartedAt])
  @@map("privacy_request")
}

/// Infraestructura COMPARTIDA de plataforma, no propiedad de ningún dominio --
/// ver docs/adr/0006-analytics-foundation.md. Cualquier dominio puede publicar
/// (AUTH y PRIVACY hoy); ANALYTICS es el primer consumidor, pero el diseño
/// admite consumidores futuros (Gamification, Progress, Recommendation...)
/// leyendo la misma tabla con su propio cursor/criterio.
enum OutboxEventStatus {
  PENDING
  PROCESSED
  FAILED

  @@map("outbox_event_status")
}

model OutboxEvent {
  id              String            @id @default(uuid()) @db.Uuid
  eventKey        String            @map("event_key")
  schemaVersion   String            @map("schema_version")
  sourceDomain    String            @map("source_domain")
  aggregateId     String?           @map("aggregate_id") @db.Uuid
  /// Versión del backend que publicó el evento (trazabilidad entre
  /// versiones) -- ver ADR-0006, ajuste 2. Best-effort: puede faltar si la
  /// variable de entorno no está configurada.
  producerVersion String?           @map("producer_version")
  occurredAt      DateTime          @map("occurred_at")
  payload         Json
  /// @deprecated (ADR-0017): ya NO representa el estado de consumo -- un
  /// esquema con un único `status` no admite múltiples consumidores (ver
  /// ADR-0017, "alternativa nula"). Queda congelado en el valor de inserción
  /// (PENDING), sin uso por ningún consumidor. El estado de consumo real
  /// vive en `OutboxEventDelivery`, una fila por combinación evento×consumidor.
  /// No se elimina todavía (valor forense durante la transición) -- ver
  /// ADR-0017, "OutboxEvent.status -- decisión formal".
  status          OutboxEventStatus @default(PENDING)
  /// @deprecated (ADR-0017): ver `status`. Reemplazado por
  /// `OutboxEventDelivery.attempts`, por consumidor.
  attempts        Int               @default(0)
  /// @deprecated (ADR-0017): ver `status`. Reemplazado por
  /// `OutboxEventDelivery.lastError`, por consumidor.
  lastError       String?           @map("last_error")
  createdAt       DateTime          @default(now()) @map("created_at")
  /// @deprecated (ADR-0017): ver `status`. Reemplazado por
  /// `OutboxEventDelivery.processedAt`, por consumidor.
  processedAt     DateTime?         @map("processed_at")

  deliveries OutboxEventDelivery[]

  @@index([status, createdAt])
  @@map("outbox_event")
}

/// Estado de entrega de un OutboxEvent a UN consumidor concreto -- ver
/// docs/adr/0017-entrega-multiconsumidor-outbox.md. "Pendiente" es la
/// AUSENCIA de fila (mismo criterio que `CurriculumTopicProgress`,
/// ADR-0014: "NOT_STARTED = ausencia de fila") -- por eso el enum de estado
/// no tiene un valor PENDING persistido, solo resultados terminales.
enum OutboxDeliveryStatus {
  PROCESSED
  FAILED

  @@map("outbox_delivery_status")
}

model OutboxEventDelivery {
  id            String               @id @default(uuid()) @db.Uuid
  outboxEventId String               @map("outbox_event_id") @db.Uuid
  /// 'ANALYTICS' | 'GAMIFICATION' | futuros -- sin tabla de catálogo todavía,
  /// mismo criterio de alcance mínimo que ADR-0006 aplicó a los eventKey de
  /// ANALYTICS (registro en código, no en base de datos).
  consumerName  String               @map("consumer_name")
  status        OutboxDeliveryStatus
  attempts      Int                  @default(0)
  lastError     String?              @map("last_error")
  processedAt   DateTime?            @map("processed_at")
  createdAt     DateTime             @default(now()) @map("created_at")

  outboxEvent OutboxEvent @relation(fields: [outboxEventId], references: [id], onDelete: Cascade)

  @@unique([outboxEventId, consumerName])
  @@index([consumerName, createdAt])
  @@map("outbox_event_delivery")
}

/// Dominio ANALYTICS. Subconjunto mínimo del Bloque 19 del Data Model -- ver
/// docs/adr/0006-analytics-foundation.md. Analytics NUNCA escribe aquí
/// directamente desde otro dominio: solo el relay de ANALYTICS, consumiendo
/// OutboxEvent ya publicado. Sin FK a Account (mismo criterio que
/// PrivacyRequest): desacople de esquema entre dominios.
model AnalyticsEvent {
  id                String   @id @default(uuid()) @db.Uuid
  eventKey          String   @map("event_key")
  schemaVersion     String   @map("schema_version")
  sourceDomain      String   @map("source_domain")
  /// HMAC-SHA256(accountId) -- nunca el accountId crudo. Versión mínima de
  /// pseudonimización, no el analytics_actor completo del Data Model (sin
  /// rotación ni ciclo de vida propio) -- ver ADR-0006.
  analyticsActorRef String?  @map("analytics_actor_ref")
  producerVersion   String?  @map("producer_version")
  occurredAt        DateTime @map("occurred_at")
  receivedAt        DateTime @default(now()) @map("received_at")
  payload           Json
  /// = OutboxEvent.id -- evita duplicar el mismo evento si el relay reprocesa.
  idempotencyKey    String   @unique @map("idempotency_key")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([eventKey, occurredAt])
  @@map("analytics_event")
}

/// Dominio USER. Perfil privado mínimo -- equivalente reducido de
/// `student_profile` (Data Model Bloque 6.3), NO `public_profile` (identidad
/// pública/username, fuera de alcance hasta Fase 4). Ver
/// docs/adr/0008-gestion-usuarios-perfil-basico.md.
/// Sin FK a Account -- mismo criterio que PrivacyRequest: desacople de
/// esquema entre dominios (Master Context 6.2, USER y AUTH son conceptos
/// deliberadamente separados). `accountId` único fuerza el 1:1.
model UserProfile {
  id          String   @id @default(uuid()) @db.Uuid
  accountId   String   @unique @map("account_id") @db.Uuid
  displayName String   @map("display_name")
  /// Default de producto (America/Santiago), no una inferencia -- ver ADR-0008.
  timezone    String
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("user_profile")
}

/// §6.5 del Data Model -- ver docs/adr/0018-public-profile-foundation.md
/// (incremento "Public Profile Foundation", Bloque II). Primitiva de
/// identidad pública, distinta de `UserProfile` (privado). Creación
/// perezosa e idempotente (`UserService.ensurePublicProfile`), SIEMPRE con
/// `visibilityStatus = PRIVATE` -- ninguna ruta de creación produce un
/// perfil visible por defecto (precisión obligatoria del Product Owner).
///
/// `visibilityStatus` y `lifecycleStatus` son atributos INDEPENDIENTES a
/// propósito (ver ADR-0018 §4): ocultar visibilidad nunca implica retiro
/// ni anonimización, y viceversa.
///
/// `usernameNormalized` es único de forma PERMANENTE en esta tabla -- solo
/// protege el valor ACTUAL de cada perfil. La ventana de reserva de 30
/// días sobre un username REEMPLAZADO o huérfano (cuenta cerrada) se
/// aplica en la capa de aplicación consultando `profile_username_history`
/// (`PublicProfileRepository.findRecentRelease`), no mediante una
/// restricción de esquema -- un valor liberado deja de estar en esta
/// columna (pasa a otro valor o el perfil queda ANONYMIZED reteniéndolo),
/// pero sigue bloqueado para otra cuenta mientras exista una fila de
/// historial reciente que lo mencione como `previousUsernameNormalized`.
model PublicProfile {
  id                 String                        @id @default(uuid()) @db.Uuid
  accountId          String                        @unique @map("account_id") @db.Uuid
  usernameNormalized String                        @unique @map("username_normalized")
  avatarReference    String?                       @map("avatar_reference")
  visibilityStatus   PublicProfileVisibilityStatus @default(PRIVATE) @map("visibility_status")
  lifecycleStatus    PublicProfileLifecycleStatus  @default(ACTIVE) @map("lifecycle_status")
  usernameChangedAt  DateTime                      @default(now()) @map("username_changed_at")
  retiredAt          DateTime?                     @map("retired_at")
  anonymizedAt       DateTime?                     @map("anonymized_at")
  createdAt          DateTime                      @default(now()) @map("created_at")
  updatedAt          DateTime                      @updatedAt @map("updated_at")

  usernameHistory   ProfileUsernameHistory[]
  /// Bloque III, sub-incremento 3.b -- lado inverso de EquippedTitle.publicProfileId.
  equippedTitle     EquippedTitle?
  /// Bloque III, sub-incremento 5.b -- lado inverso de EquippedCosmetic.publicProfileId (varias filas, una por slot).
  equippedCosmetics EquippedCosmetic[]

  @@map("public_profile")
}

enum PublicProfileVisibilityStatus {
  PRIVATE
  VISIBLE

  @@map("public_profile_visibility_status")
}

enum PublicProfileLifecycleStatus {
  ACTIVE
  RETIRED
  ANONYMIZED

  @@map("public_profile_lifecycle_status")
}

/// §6.7 del Data Model. Append-only -- ningún código actualiza o borra una
/// fila existente, solo agrega. `changeReason` documenta el origen del
/// cambio para auditoría (nunca se usa para mostrar públicamente nombres
/// anteriores -- Data Model §6.7).
model ProfileUsernameHistory {
  id                         String                      @id @default(uuid()) @db.Uuid
  publicProfileId            String                      @map("public_profile_id") @db.Uuid
  previousUsernameNormalized String?                     @map("previous_username_normalized")
  newUsernameNormalized      String                      @map("new_username_normalized")
  changeReason               ProfileUsernameChangeReason @map("change_reason")
  changedAt                  DateTime                    @default(now()) @map("changed_at")

  publicProfile PublicProfile @relation(fields: [publicProfileId], references: [id], onDelete: Restrict)

  @@index([publicProfileId])
  @@map("profile_username_history")
}

enum ProfileUsernameChangeReason {
  INITIAL_CLAIM
  USER_CHANGE
  ACCOUNT_CLOSURE

  @@map("profile_username_change_reason")
}

/// Dominio GAMIFICATION, Bloque I de Learning Experience Foundation (Fase
/// 2) -- ver docs/adr/0016-gamificacion-fundacion.md. Solo persistencia y
/// contratos internos: SIN productor (PROGRESS no publica todavía), SIN
/// GamificationRelayWorker, SIN cálculo efectivo de XP. Data Model Bloque
/// 16, subconjunto mínimo (§16.4/16.5/16.7/16.8/16.9) -- niveles, rachas,
/// logros, títulos, desafíos, temporadas y ligas (§16.11-16.20) quedan
/// fuera hasta los bloques que los necesiten (Kickoff Learning Experience
/// Foundation, roadmap de 8 bloques).
enum GamificationProgramStatus {
  ACTIVE
  RETIRED

  @@map("gamification_program_status")
}

/// §16.4. Representa un sistema lógico de progresión (hoy solo XP -- racha,
/// liga u otro program_type llegarán con sus propios bloques).
model GamificationProgram {
  id          String                    @id @default(uuid()) @db.Uuid
  programKey  String                    @unique @map("program_key")
  name        String
  description String?
  /// Abierto ("XP, racha, liga u otro" -- Data Model §16.4): String, no
  /// enum, mismo criterio que OutboxEventDelivery.consumerName (ADR-0017).
  programType String                    @map("program_type")
  status      GamificationProgramStatus @default(ACTIVE)
  createdAt   DateTime                  @default(now()) @map("created_at")
  retiredAt   DateTime?                 @map("retired_at")

  versions GamificationProgramVersion[]

  @@map("gamification_program")
}

enum GamificationProgramVersionApprovalStatus {
  DRAFT
  APPROVED
  RETIRED

  @@map("gamification_program_version_approval_status")
}

/// §16.4. "Todo cambio material en XP, rachas, ligas o recompensas
/// requerirá una versión nueva" -- versionLabel único por programa.
model GamificationProgramVersion {
  id                    String                                   @id @default(uuid()) @db.Uuid
  gamificationProgramId String                                   @map("gamification_program_id") @db.Uuid
  versionLabel          String                                   @map("version_label")
  ruleSetReference      String?                                  @map("rule_set_reference")
  effectiveFrom         DateTime?                                @map("effective_from")
  effectiveUntil        DateTime?                                @map("effective_until")
  changeSummary         String?                                  @map("change_summary")
  approvalStatus        GamificationProgramVersionApprovalStatus @default(DRAFT) @map("approval_status")
  createdAt             DateTime                                 @default(now()) @map("created_at")
  approvedAt            DateTime?                                @map("approved_at")

  program GamificationProgram @relation(fields: [gamificationProgramId], references: [id], onDelete: Restrict)
  xpRules XpRule[]

  @@unique([gamificationProgramId, versionLabel])
  @@map("gamification_program_version")
}

enum XpRuleStatus {
  ACTIVE
  RETIRED

  @@map("xp_rule_status")
}

/// §16.9. Única por (versión, tipo de actividad) -- decisión propia de este
/// incremento (no citada textualmente en el Data Model) para impedir reglas
/// ambiguas duplicadas dentro de una misma versión.
model XpRule {
  id               String       @id @default(uuid()) @db.Uuid
  programVersionId String       @map("program_version_id") @db.Uuid
  /// Abierto -- mismo criterio que GamificationProgram.programType.
  activityType     String       @map("activity_type")
  repeatDecayRule  String?      @map("repeat_decay_rule")
  qualityCondition String?      @map("quality_condition")
  baseXp           Int          @map("base_xp")
  multiplierPolicy String?      @map("multiplier_policy")
  dailyCap         Int?         @map("daily_cap")
  effectiveFrom    DateTime?    @map("effective_from")
  effectiveUntil   DateTime?    @map("effective_until")
  status           XpRuleStatus @default(ACTIVE)

  programVersion GamificationProgramVersion @relation(fields: [programVersionId], references: [id], onDelete: Restrict)
  ledgerEntries  XpLedgerEntry[]

  @@unique([programVersionId, activityType])
  @@map("xp_rule")
}

/// §16.5. "Gamificación no leerá respuestas crudas para inventar
/// recompensas. Consumirá hechos publicados por los dominios propietarios."
/// `accountId` SIN FK a Account -- mismo criterio que
/// CurriculumTopicProgress/StudentResponse (ADR-0014): desacople de esquema
/// entre dominios. `sourceEntityId` es una referencia estable genérica (el
/// hecho originador puede vivir en StudentResponse, CurriculumTopicProgress
/// u otro dominio futuro) -- sin FK dura, mismo motivo que AnalyticsEvent no
/// la tiene hacia Account.
model ValidatedGamificationActivity {
  id                    String   @id @default(uuid()) @db.Uuid
  accountId             String   @map("account_id") @db.Uuid
  sourceDomain          String   @map("source_domain")
  /// "Intento, recurso, objetivo u otro" (§16.5) -- abierto, String.
  sourceEntityType      String   @map("source_entity_type")
  sourceEntityId        String   @map("source_entity_id") @db.Uuid
  /// Abierto -- mismo criterio que GamificationProgram.programType.
  activityType          String   @map("activity_type")
  /// Sin enum todavía: ningún servicio de este incremento decide su
  /// conjunto de valores real (el relay que lo hará no existe aún) -- ver
  /// brief de este incremento.
  validationStatus      String   @map("validation_status")
  validationRuleVersion String   @map("validation_rule_version")
  occurredAt            DateTime @map("occurred_at")
  validatedAt           DateTime @default(now()) @map("validated_at")
  /// "Prevención de duplicados" (§16.5) -- única, es su propósito declarado.
  deduplicationKey      String   @unique @map("deduplication_key")
  /// Mismo criterio que validationStatus: String, sin enum todavía.
  integrityStatus       String   @map("integrity_status")

  ledgerEntries            XpLedgerEntry[]
  grantAttempt             XpGrantAttempt?
  /// Bloque IV, Incremento 1 -- relación PARALELA a `ledgerEntries` (XP),
  /// nunca la misma. El origen (esta fila) se comparte; el otorgamiento de
  /// League Points es una lectura independiente, sin transacción compartida
  /// con XP (ver LEF-BLOCK-IV-DEFINITION.md §9.7).
  leaguePointLedgerEntries LeaguePointLedgerEntry[]

  @@index([accountId])
  @@map("validated_gamification_activity")
}

/// Seguimiento de intentos de otorgamiento -- NUNCA modifica
/// validated_gamification_activity (condición arquitectónica explícita del
/// incremento de otorgamiento): es una tabla auxiliar propia, mismo patrón
/// ya usado por outbox_event_delivery (ADR-0017) para no mutar la tabla de
/// hechos. Existe solo para resultados TRANSITORIOS (sin regla activa, tope
/// diario alcanzado) -- un otorgamiento exitoso no necesita seguimiento
/// aquí: la propia xp_ledger_entry ya es el registro terminal.
///
/// Previene "polling perpetuo" y starvation: una actividad con intentos
/// fallidos deja de competir por el cupo de cada ciclo hasta
/// `nextEligibleAt` (backoff creciente y acotado para NO_ACTIVE_RULE;
/// exactamente la medianoche UTC siguiente para DAILY_CAP_REACHED). El
/// backoff por sí solo NO basta: una vez vencido, `attempts` es lo que
/// mantiene a las actividades nuevas (sin intento todavía) por delante de
/// un backlog viejo sin regla -- ver orden en
/// ValidatedGamificationActivityRepository.findPendingGrant.
model XpGrantAttempt {
  id                  String   @id @default(uuid()) @db.Uuid
  validatedActivityId String   @unique @map("validated_activity_id") @db.Uuid
  attempts            Int      @default(0)
  /// 'NO_ACTIVE_RULE' | 'DAILY_CAP_REACHED' -- solo resultados transitorios.
  lastOutcome         String   @map("last_outcome")
  lastAttemptedAt     DateTime @map("last_attempted_at")
  nextEligibleAt      DateTime @map("next_eligible_at")
  createdAt           DateTime @default(now()) @map("created_at")

  validatedActivity ValidatedGamificationActivity @relation(fields: [validatedActivityId], references: [id], onDelete: Restrict)

  @@index([nextEligibleAt])
  @@map("xp_grant_attempt")
}

/// §16.7: "Otorgamiento, bono, reverso o ajuste" -- 4 valores explícitos en
/// el Data Model, a diferencia de los campos "abiertos" de arriba.
enum XpLedgerEntryType {
  OTORGAMIENTO
  BONO
  REVERSO
  AJUSTE

  @@map("xp_ledger_entry_type")
}

/// §16.7: "Sistema o administrador autorizado" -- 2 valores explícitos.
enum XpLedgerActorType {
  SYSTEM
  ADMIN

  @@map("xp_ledger_actor_type")
}

/// §16.7. Libro mayor INMUTABLE (trigger `enforce_xp_ledger_entry_immutable`,
/// mismo patrón que `student_response`/ADR-0014 -- ningún UPDATE permitido).
/// "Reversible" (ADR-0016) = entrada compensatoria únicamente: CHECK a nivel
/// de base de datos aplica que entryType = REVERSO exija reversesEntryId, y
/// que cualquier otro tipo lo prohíba. `reversesEntryId` es además ÚNICO
/// (a lo sumo un reverso por entrada original) y un trigger de integridad
/// (`enforce_xp_ledger_entry_reversal_integrity`) valida contra la entrada
/// original: debe ser OTORGAMIENTO, misma cuenta, y xpAmount exactamente su
/// negativo -- ver migración y brief del incremento de otorgamiento.
/// `xpRuleId` es la referencia ESTABLE a la regla que determinó el
/// otorgamiento (obligatoria para OTORGAMIENTO, exigido por CHECK); la
/// versión del programa se deriva vía `xpRule.programVersionId`, sin
/// duplicar la columna.
/// `accountId` sin FK a Account, mismo criterio que ValidatedGamificationActivity.
model XpLedgerEntry {
  id                  String            @id @default(uuid()) @db.Uuid
  accountId           String            @map("account_id") @db.Uuid
  /// Nullable: obligatorio a nivel de aplicación para OTORGAMIENTO (cuando
  /// exista el servicio que lo escriba); REVERSO no lo usa, referencia la
  /// entrada original vía reversesEntryId.
  validatedActivityId String?           @map("validated_activity_id") @db.Uuid
  /// Referencia estable a la regla aplicada -- obligatoria para OTORGAMIENTO
  /// (CHECK `xp_ledger_entry_otorgamiento_requires_rule`), ausente en REVERSO.
  xpRuleId            String?           @map("xp_rule_id") @db.Uuid
  entryType           XpLedgerEntryType @map("entry_type")
  xpAmount            Int               @map("xp_amount")
  baseXpAmount        Int?              @map("base_xp_amount")
  multiplierReference String?           @map("multiplier_reference")
  ruleVersion         String?           @map("rule_version")
  reasonCode          String?           @map("reason_code")
  /// Idempotencia de escritura -- única, mismo criterio que StudentResponse.operationId.
  idempotencyKey      String            @unique @map("idempotency_key")
  occurredAt          DateTime          @map("occurred_at")
  recordedAt          DateTime          @default(now()) @map("recorded_at")
  /// Único: a lo sumo un reverso por entrada original (protección de base de
  /// datos, además de la idempotencyKey `reverse:${originalEntryId}` del
  /// servicio).
  reversesEntryId     String?           @unique @map("reverses_entry_id") @db.Uuid
  createdByActorType  XpLedgerActorType @default(SYSTEM) @map("created_by_actor_type")

  validatedActivity       ValidatedGamificationActivity?  @relation(fields: [validatedActivityId], references: [id], onDelete: Restrict)
  xpRule                  XpRule?                         @relation(fields: [xpRuleId], references: [id], onDelete: Restrict)
  reversesEntry           XpLedgerEntry?                  @relation("XpLedgerEntryReversal", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversedBy              XpLedgerEntry?                  @relation("XpLedgerEntryReversal")
  balances                XpBalance[]
  /// Bloque III, sub-incremento 2.b -- lado inverso de AchievementProgress.lastActivityId.
  achievementProgressRows AchievementProgress[]
  /// Bloque III, sub-incremento 2.b -- lado inverso de AchievementUnlock.triggerActivityId.
  achievementUnlocks      AchievementUnlock[]
  /// Bloque III, sub-incremento 4.b -- lado inverso de AccountChallengeConsumedEvent.xpLedgerEntryId.
  challengeConsumedEvents AccountChallengeConsumedEvent[]

  @@index([accountId])
  @@map("xp_ledger_entry")
}

/// §16.8. "Representa una proyección materializada [...] deberá poder
/// reconstruirse completamente desde xp_ledger_entry" -- en este incremento
/// la tabla existe con su forma correcta, pero NINGÚN código escribe
/// valores reales todavía (cálculo de XP fuera de alcance). `currentLevelId`
/// (depende de level_definition, Bloque III) y `seasonXp` (depende de
/// game_season, Bloque II) quedan deliberadamente fuera -- ninguno de esos
/// dominios existe todavía (ver brief de este incremento).
model XpBalance {
  id                String   @id @default(uuid()) @db.Uuid
  accountId         String   @unique @map("account_id") @db.Uuid
  lifetimeXp        Int      @default(0) @map("lifetime_xp")
  balanceVersion    Int      @default(0) @map("balance_version")
  lastLedgerEntryId String?  @map("last_ledger_entry_id") @db.Uuid
  calculatedAt      DateTime @default(now()) @map("calculated_at")

  lastLedgerEntry XpLedgerEntry? @relation(fields: [lastLedgerEntryId], references: [id], onDelete: Restrict)

  @@map("xp_balance")
}

/// §16.11. Escalera de niveles, Bloque II (Progresión Visible) --
/// ver docs/adr/BLOCK-II-DEFINITION.md. Simplificación deliberada frente al
/// Data Model: sin `program_version_id` (sin workflow de aprobación
/// versionada para la escalera en este incremento -- mismo criterio de
/// alcance mínimo que XpBalance omitiendo currentLevelXp/seasonXp en el
/// Bloque I). `account_level_history` NO se persiste: el nivel actual se
/// deriva siempre en tiempo de lectura desde xp_balance.lifetimeXp contra
/// estos umbrales -- no hay proyección que reconciliar ni que pueda
/// divergir.
model LevelDefinition {
  id                String                @id @default(uuid()) @db.Uuid
  levelNumber       Int                   @unique @map("level_number")
  levelName         String?               @map("level_name")
  minimumLifetimeXp Int                   @map("minimum_lifetime_xp")
  status            LevelDefinitionStatus @default(ACTIVE)
  createdAt         DateTime              @default(now()) @map("created_at")
  /// Bloque III, sub-incremento 1.c (ADR-0019, BLOCK-III-DEFINITION.md
  /// §4.1 -- trasladado desde el Incremento 5, ver nota histórica).
  /// Nullable: no todo nivel otorga recompensa. Añadido DESPUÉS de que
  /// `verify:gamification-progression-gate` (Bloque II) ya estaba en PASS
  /// -- columna aditiva, ese gate no se modifica ni se re-escribe.
  rewardBundleId    String?               @map("reward_bundle_id") @db.Uuid

  rewardBundle RewardBundle? @relation(fields: [rewardBundleId], references: [id], onDelete: Restrict)

  @@index([rewardBundleId])
  @@map("level_definition")
}

enum LevelDefinitionStatus {
  ACTIVE
  RETIRED

  @@map("level_definition_status")
}

/// Sub-incremento 1.a del Bloque III ("Fundación de persistencia") -- ver
/// ADR-0019 y docs/adr/BLOCK-III-DEFINITION.md. Data Model §16.36.
/// SOLO esquema/repositorios de solo-lectura+creación en 1.a -- SIN worker,
/// SIN cron, SIN endpoint interno, SIN lectura de xp_ledger_entry, SIN
/// evaluación de niveles/logros/desafíos, SIN entrega real de
/// títulos/cosméticos/bonos, SIN escritura sobre inventario ni
/// public_profile (ver ADR-0019 "Alcance de este ADR").
/// Sub-incremento 1.c extiende esto SOLO para XP_BONUS vía nivel
/// (LevelDefinition.rewardBundleId, abajo) -- TITLE/COSMETIC siguen sin
/// entrega real (Incrementos 3/5).
model RewardBundle {
  id        String             @id @default(uuid()) @db.Uuid
  bundleKey String             @unique @map("bundle_key")
  name      String
  status    RewardBundleStatus @default(ACTIVE)
  createdAt DateTime           @default(now()) @map("created_at")

  items                RewardBundleItem[]
  grants               RewardGrant[]
  /// Bloque III, sub-incremento 1.c -- lado inverso de LevelDefinition.rewardBundleId.
  levelDefinitions     LevelDefinition[]
  /// Bloque III, sub-incremento 2.a -- lado inverso de AchievementVersion.rewardBundleId.
  achievementVersions  AchievementVersion[]
  /// Bloque III, sub-incremento 4.a -- lado inverso de ChallengeDefinition.rewardBundleId.
  challengeDefinitions ChallengeDefinition[]
  leagueDefinitions    LeagueDefinition[]

  @@map("reward_bundle")
}

enum RewardBundleStatus {
  ACTIVE
  RETIRED

  @@map("reward_bundle_status")
}

/// Configuración de lo que UN reward_bundle PUEDE entregar -- mutable
/// (sin versión propia, ADR-0019 §5/§3 de BLOCK-III-DEFINITION.md). Nunca
/// se lee en vivo al momento de entregar: reward_grant_component copia
/// (snapshot) estos valores, no los referencia. `referenceId` SIN FK a
/// title_definition/cosmetic_item -- esas tablas no existen todavía
/// (Incrementos 3/5); se añadirá la restricción cuando existan, mismo
/// criterio que LevelDefinition.reward_bundle_id (sin FK primero).
/// CHECK de coherencia por component_type añadido a mano en la migración
/// (Prisma no expresa esta validación condicional de forma nativa).
model RewardBundleItem {
  id             String              @id @default(uuid()) @db.Uuid
  rewardBundleId String              @map("reward_bundle_id") @db.Uuid
  componentType  RewardComponentType @map("component_type")
  /// Obligatorio y > 0 si componentType = XP_BONUS; NULL en cualquier otro caso (CHECK).
  xpAmount       Int?                @map("xp_amount")
  /// Obligatorio si componentType = TITLE/COSMETIC; NULL si XP_BONUS (CHECK).
  referenceId    String?             @map("reference_id") @db.Uuid
  createdAt      DateTime            @default(now()) @map("created_at")

  rewardBundle RewardBundle @relation(fields: [rewardBundleId], references: [id], onDelete: Restrict)

  @@index([rewardBundleId])
  @@map("reward_bundle_item")
}

enum RewardComponentType {
  XP_BONUS
  TITLE
  COSMETIC

  @@map("reward_component_type")
}

/// Cabecera de una entrega -- INMUTABLE por completo (ningún campo se
/// actualiza tras crearse; sin `grantStatus` persistido a propósito --
/// precisión obligatoria del Product Owner: el estado se deriva SIEMPRE de
/// `components` mediante una función pura, nunca se guarda como una
/// segunda representación que podría desalinearse). `idempotencyKey =
/// "reward:{sourceEntityType}:{sourceEntityId}"` (ADR-0019 §5/§4.4 de
/// BLOCK-III-DEFINITION.md). `accountId` SIN FK a `account` -- mismo
/// desacoplamiento de dominio que el resto de GAMIFICATION y que
/// `PrivacyRequest` (ADR-0005). `sourceEntityId` es `String`, no `Uuid`:
/// la fuente LEVEL usa la clave compuesta "{accountId}:{levelNumber}".
model RewardGrant {
  id               String                 @id @default(uuid()) @db.Uuid
  accountId        String                 @map("account_id") @db.Uuid
  rewardBundleId   String                 @map("reward_bundle_id") @db.Uuid
  sourceEntityType RewardSourceEntityType @map("source_entity_type")
  sourceEntityId   String                 @map("source_entity_id")
  idempotencyKey   String                 @unique @map("idempotency_key")
  createdAt        DateTime               @default(now()) @map("created_at")

  rewardBundle      RewardBundle           @relation(fields: [rewardBundleId], references: [id], onDelete: Restrict)
  components        RewardGrantComponent[]
  /// Bloque III, sub-incremento 2.b -- lado inverso de AchievementUnlock.rewardGrantId (@unique -- a lo sumo un unlock por grant).
  achievementUnlock AchievementUnlock?

  @@index([accountId])
  @@map("reward_grant")
}

enum RewardSourceEntityType {
  LEVEL
  ACHIEVEMENT_UNLOCK
  CHALLENGE_CLAIM

  @@map("reward_source_entity_type")
}

/// Snapshot desnormalizado de UN componente ya entregado (o en curso de
/// entrega) -- NUNCA una referencia viva a `reward_bundle_item` (ADR-0019
/// §5). `DELIVERED` es terminal: trigger de base de datos rechaza UPDATE
/// cuando `OLD.delivery_status = 'DELIVERED'`, y rechaza DELETE
/// incondicionalmente (mismo criterio que `xp_ledger_entry`, Bloque I).
/// Mismo CHECK de coherencia por `component_type` que `reward_bundle_item`.
model RewardGrantComponent {
  id             String               @id @default(uuid()) @db.Uuid
  rewardGrantId  String               @map("reward_grant_id") @db.Uuid
  componentType  RewardComponentType  @map("component_type")
  xpAmount       Int?                 @map("xp_amount")
  referenceId    String?              @map("reference_id") @db.Uuid
  deliveryStatus RewardDeliveryStatus @default(PENDING) @map("delivery_status")
  deliveredAt    DateTime?            @map("delivered_at")
  createdAt      DateTime             @default(now()) @map("created_at")

  rewardGrant RewardGrant @relation(fields: [rewardGrantId], references: [id], onDelete: Restrict)

  @@index([rewardGrantId])
  @@map("reward_grant_component")
}

enum RewardDeliveryStatus {
  PENDING
  DELIVERED
  FAILED

  @@map("reward_delivery_status")
}

/// Cursor POR CUENTA (clave primaria account_id, no fila única) -- ADR-0019
/// §1, corrección obligatoria del Product Owner sobre un diseño inicial de
/// cursor global que podía omitir una cuenta con fallo de forma permanente.
/// `lastProcessedRecordedAt` es NULLABLE: NULL significa "nunca procesada
/// con éxito todavía" -- una cuenta puede tener fila propia (para registrar
/// `attempts`/`nextEligibleAt` de un primer intento fallido) sin haber
/// completado nunca una pasada exitosa. Sin uso todavía en este
/// sub-incremento (sin worker) -- solo el esquema.
model RewardEvaluationCursor {
  accountId               String    @id @map("account_id") @db.Uuid
  lastProcessedRecordedAt DateTime? @map("last_processed_recorded_at")
  /// Orden compuesto (recordedAt, id) -- ADR-0019 §1, precisión obligatoria
  /// del Product Owner (sub-incremento 1.b): evita omitir entradas que
  /// comparten `recordedAt` exacto. Ambos campos nulos juntos = nunca
  /// procesada con éxito; ambos no nulos juntos tras el primer éxito --
  /// nunca uno sin el otro (CHECK añadido a mano en la migración).
  lastProcessedEntryId    String?   @map("last_processed_entry_id") @db.Uuid
  attempts                Int       @default(0)
  nextEligibleAt          DateTime  @default(now()) @map("next_eligible_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")

  @@map("reward_evaluation_cursor")
}

/// Bloque III, sub-incremento 2.a ("Fundación de persistencia de logros")
/// -- ver docs/adr/BLOCK-III-DEFINITION.md (Incremento 2) y ADR-0019 (el
/// mecanismo de entrega que este logro consumirá ya está resuelto, no se
/// rediseña aquí). Data Model §16.15. SOLO esquema/repositorios de
/// solo-lectura+creación en 2.a -- SIN worker, SIN cálculo de progreso,
/// SIN `achievement_progress`/`achievement_unlock` (dependen de la
/// excepción controlada fijada en §4.7 -- ver esos modelos cuando se
/// autorice 2.b), SIN entrega de recompensas, SIN exposición pública.
/// `achievementCategory`/`progressTrackingType` quedan `String` abiertos
/// -- mismo criterio que `GamificationProgram.programType`/
/// `XpRule.activityType` (Data Model da ejemplos, no un enum cerrado).
model AchievementDefinition {
  id                   String                      @id @default(uuid()) @db.Uuid
  achievementKey       String                      @unique @map("achievement_key")
  name                 String
  description          String?
  achievementCategory  String                      @map("achievement_category")
  visibilityClass      AchievementVisibilityClass  @map("visibility_class")
  repeatability        AchievementRepeatability
  progressTrackingType String                      @map("progress_tracking_type")
  status               AchievementDefinitionStatus @default(ACTIVE)
  createdAt            DateTime                    @default(now()) @map("created_at")
  retiredAt            DateTime?                   @map("retired_at")

  versions     AchievementVersion[]
  progressRows AchievementProgress[]
  unlocks      AchievementUnlock[]

  @@map("achievement_definition")
}

enum AchievementVisibilityClass {
  PRIVATE
  PUBLIC

  @@map("achievement_visibility_class")
}

enum AchievementRepeatability {
  UNIQUE
  REPEATABLE

  @@map("achievement_repeatability")
}

enum AchievementDefinitionStatus {
  ACTIVE
  RETIRED

  @@map("achievement_definition_status")
}

/// `unlockRule` -- almacena la FORMA CANÓNICA (JSON.stringify con orden de
/// claves fijo) de `XpThresholdUnlockRuleSchema` (2.b,
/// achievement-unlock-rule.ts) -- único `type` soportado:
/// `{schemaVersion:"v1",type:"XP_THRESHOLD",value:N}`. Sigue siendo
/// `String` a nivel de Postgres (sin migración de tipo) -- la validación
/// vive en `AchievementVersionRepository.create`, reutilizada por el
/// evaluador (`RewardEvaluationWorker`). `schemaVersion` versiona la
/// gramática técnica, nunca el criterio de negocio -- cambiar el umbral
/// exige una `achievement_version` nueva.
/// `iconAssetVersionId` -- SIN FK: no existe todavía ninguna entidad de
/// versionado de assets en el schema (mismo criterio que
/// `RewardBundleItem.referenceId` en 1.a, sin FK a title/cosmetic).
model AchievementVersion {
  id                      String                           @id @default(uuid()) @db.Uuid
  achievementDefinitionId String                           @map("achievement_definition_id") @db.Uuid
  versionLabel            String                           @map("version_label")
  unlockRule              String                           @map("unlock_rule")
  rewardBundleId          String?                          @map("reward_bundle_id") @db.Uuid
  iconAssetVersionId      String?                          @map("icon_asset_version_id") @db.Uuid
  effectiveFrom           DateTime?                        @map("effective_from")
  effectiveUntil          DateTime?                        @map("effective_until")
  approvalStatus          AchievementVersionApprovalStatus @default(DRAFT) @map("approval_status")
  createdAt               DateTime                         @default(now()) @map("created_at")
  approvedAt              DateTime?                        @map("approved_at")

  achievementDefinition AchievementDefinition @relation(fields: [achievementDefinitionId], references: [id], onDelete: Restrict)
  rewardBundle          RewardBundle?         @relation(fields: [rewardBundleId], references: [id], onDelete: Restrict)
  progressRows          AchievementProgress[]
  unlocks               AchievementUnlock[]

  @@unique([achievementDefinitionId, versionLabel])
  @@index([rewardBundleId])
  @@map("achievement_version")
}

enum AchievementVersionApprovalStatus {
  DRAFT
  APPROVED
  RETIRED

  @@map("achievement_version_approval_status")
}

/// Bloque III, sub-incremento 2.b ("Progreso y desbloqueo de logros") --
/// ver docs/adr/BLOCK-III-DEFINITION.md §4.7 (excepción controlada A1,
/// aprobada 2026-08-04) y ADR-0019. `achievementDefinitionId` es una
/// columna DENORMALIZADA exclusivamente para integridad/unicidad en
/// Postgres -- `achievementVersionId` sigue siendo la única autoridad
/// semántica para evaluar reglas e interpretar progreso, nunca
/// reinterpretado vía `achievementDefinitionId`. Consistencia entre ambas
/// columnas reforzada por trigger (`enforce_achievement_progress_definition_version_consistency`),
/// no solo por disciplina de aplicación. `achievementVersionId` y
/// `progressStatus = COMPLETED` son INMUTABLES una vez fijados -- trigger
/// `enforce_achievement_progress_immutable` rechaza cualquier UPDATE que
/// cambie `achievement_version_id` o que parta de `COMPLETED`. Sin
/// DELETE bajo ninguna circunstancia (mismo trigger).
model AchievementProgress {
  id                      String                    @id @default(uuid()) @db.Uuid
  accountId               String                    @map("account_id") @db.Uuid
  achievementDefinitionId String                    @map("achievement_definition_id") @db.Uuid
  achievementVersionId    String                    @map("achievement_version_id") @db.Uuid
  currentValue            Int                       @map("current_value")
  targetValue             Int                       @map("target_value")
  progressStatus          AchievementProgressStatus @default(IN_PROGRESS) @map("progress_status")
  /// Último `xp_ledger_entry` leído para este recómputo -- única entrada
  /// que el worker consume (ADR-0019 §2), nunca `validated_gamification_activity`.
  lastActivityId          String?                   @map("last_activity_id") @db.Uuid
  updatedAt               DateTime                  @updatedAt @map("updated_at")

  achievementDefinition AchievementDefinition @relation(fields: [achievementDefinitionId], references: [id], onDelete: Restrict)
  achievementVersion    AchievementVersion    @relation(fields: [achievementVersionId], references: [id], onDelete: Restrict)
  lastActivity          XpLedgerEntry?        @relation(fields: [lastActivityId], references: [id], onDelete: Restrict)

  @@unique([accountId, achievementDefinitionId])
  @@index([achievementVersionId])
  @@map("achievement_progress")
}

enum AchievementProgressStatus {
  IN_PROGRESS
  COMPLETED

  @@map("achievement_progress_status")
}

/// `unlockInstance` empieza en 1 -- 2.b solo produce la instancia 1
/// (`repeatability = UNIQUE`); `REPEATABLE` queda explícitamente fuera de
/// este sub-incremento (el reinicio de progreso tras desbloquear no está
/// definido por ningún documento -- vacío para un incremento futuro).
/// `rewardGrantId` nace NULL -- necesita el `id` propio de esta fila para
/// la clave `reward:ACHIEVEMENT_UNLOCK:{id}` (§4.4), así que el grant se
/// crea DESPUÉS del unlock, nunca antes. Única transición permitida:
/// `reward_grant_id` NULL -> valor, con el resto de columnas sin cambiar
/// -- trigger `enforce_achievement_unlock_immutable` rechaza cualquier
/// otra modificación y todo DELETE. `status = REVERSED` reservado para una
/// futura herramienta de moderación -- este mecanismo NUNCA lo produce
/// (mismo criterio que `RewardGrant.grantStatus = REVERSED`, ADR-0019).
model AchievementUnlock {
  id                      String                  @id @default(uuid()) @db.Uuid
  accountId               String                  @map("account_id") @db.Uuid
  achievementDefinitionId String                  @map("achievement_definition_id") @db.Uuid
  achievementVersionId    String                  @map("achievement_version_id") @db.Uuid
  unlockInstance          Int                     @map("unlock_instance")
  unlockedAt              DateTime                @map("unlocked_at")
  triggerActivityId       String?                 @map("trigger_activity_id") @db.Uuid
  rewardGrantId           String?                 @unique @map("reward_grant_id") @db.Uuid
  status                  AchievementUnlockStatus @default(ACTIVE)
  reversedAt              DateTime?               @map("reversed_at")

  achievementDefinition AchievementDefinition @relation(fields: [achievementDefinitionId], references: [id], onDelete: Restrict)
  achievementVersion    AchievementVersion    @relation(fields: [achievementVersionId], references: [id], onDelete: Restrict)
  triggerActivity       XpLedgerEntry?        @relation(fields: [triggerActivityId], references: [id], onDelete: Restrict)
  rewardGrant           RewardGrant?          @relation(fields: [rewardGrantId], references: [id], onDelete: Restrict)

  @@unique([accountId, achievementDefinitionId, unlockInstance])
  @@map("achievement_unlock")
}

enum AchievementUnlockStatus {
  ACTIVE
  REVERSED

  @@map("achievement_unlock_status")
}

/// Bloque III, Incremento 3, sub-incremento 3.a ("Fundación de
/// persistencia y entrega de títulos") -- ver
/// docs/adr/BLOCK-III-DEFINITION.md (Incremento 3) y ADR-0019 (el
/// mecanismo de entrega genérico no se rediseña, se reutiliza). Data Model
/// §16.17. `rarityClass`/`unlockSourceType` quedan `String` abiertos --
/// mismo criterio que `AchievementDefinition.achievementCategory` (Data
/// Model no los enumera; `cosmetic_item.rarity_class`, §16.33, aclara
/// explícitamente "clasificación visual... no implicará probabilidades
/// ocultas"). `unlockSourceType` es metadato descriptivo -- NUNCA gatea la
/// entrega, que ya resuelve `reward_grant`/`reward_grant_component`
/// genéricamente; la fuente autoritativa de adquisición vive en
/// `AccountTitle.acquisitionSourceType`/`acquisitionSourceId`, no aquí.
/// SOLO esquema/repositorios/entrega en 3.a -- SIN `equipped_title`, SIN
/// endpoints, SIN tocar `public_profile` (ver 3.b).
model TitleDefinition {
  id               String                @id @default(uuid()) @db.Uuid
  titleKey         String                @unique @map("title_key")
  displayText      String                @map("display_text")
  description      String?
  rarityClass      String                @map("rarity_class")
  unlockSourceType String                @map("unlock_source_type")
  visibilityStatus TitleVisibilityStatus @map("visibility_status")
  status           TitleDefinitionStatus @default(ACTIVE)
  createdAt        DateTime              @default(now()) @map("created_at")
  retiredAt        DateTime?             @map("retired_at")

  accountTitles AccountTitle[]

  @@map("title_definition")
}

enum TitleVisibilityStatus {
  PRIVATE
  PUBLIC

  @@map("title_visibility_status")
}

enum TitleDefinitionStatus {
  ACTIVE
  RETIRED

  @@map("title_definition_status")
}

/// Estructura calcada de `inventory_item` (§16.34, entidad paralela para
/// cosméticos) -- Data Model no da tabla de atributos para `account_title`
/// (solo prosa: "Cuenta, Título, Fecha de obtención, Fuente, Estado, Fecha
/// de revocación"), pero fija el mismo criterio de idempotencia
/// explícitamente para su análoga ("La adquisición será idempotente. Un
/// artículo único no deberá duplicarse accidentalmente.") --
/// `@@unique([accountId, titleDefinitionId])` es esa garantía.
/// `acquisitionSourceType`/`acquisitionSourceId` son SNAPSHOT del
/// `reward_grant` que entregó este título en el momento de la entrega
/// (mismo criterio de snapshot que `reward_grant_component`, ADR-0019
/// §4.5) -- es la fuente AUTORITATIVA de adquisición, no
/// `TitleDefinition.unlockSourceType` (metadato descriptivo del catálogo).
/// `ownershipStatus`: 3.a produce ÚNICAMENTE `ACTIVE` -- `REVOKED`/
/// `SUPERSEDED` (mismos tres valores que `inventory_item.ownership_status`)
/// quedan reservados para una herramienta de moderación futura, igual
/// criterio que `RewardGrant.grantStatus = REVERSED`/
/// `AchievementUnlock.status = REVERSED`.
model AccountTitle {
  id                    String                      @id @default(uuid()) @db.Uuid
  accountId             String                      @map("account_id") @db.Uuid
  titleDefinitionId     String                      @map("title_definition_id") @db.Uuid
  acquisitionSourceType RewardSourceEntityType      @map("acquisition_source_type")
  acquisitionSourceId   String                      @map("acquisition_source_id")
  acquiredAt            DateTime                    @map("acquired_at")
  ownershipStatus       AccountTitleOwnershipStatus @default(ACTIVE) @map("ownership_status")
  revokedAt             DateTime?                   @map("revoked_at")

  titleDefinition TitleDefinition @relation(fields: [titleDefinitionId], references: [id], onDelete: Restrict)
  equippedTitle   EquippedTitle?

  @@unique([accountId, titleDefinitionId])
  @@map("account_title")
}

enum AccountTitleOwnershipStatus {
  ACTIVE
  REVOKED
  SUPERSEDED

  @@map("account_title_ownership_status")
}

/// Bloque III, Incremento 3, sub-incremento 3.b ("Equipamiento de
/// títulos") -- ver docs/adr/BLOCK-III-DEFINITION.md (Incremento 3) y
/// ADR-0018 (public_profile). Data Model §16.17 (prosa, sin tabla de
/// atributos: "Mantiene el título seleccionado públicamente. Equipar un
/// título no cambia propiedad ni progreso.") -- estructura calcada de
/// `equipped_cosmetic` (§16.35, entidad paralela), sin concepto de slot
/// (un título es de selección única, no multi-slot como los cosméticos).
/// `publicProfileId` como PK: a lo sumo una fila por perfil, upsert al
/// cambiar selección. `accountTitleId` único: un título poseído nunca
/// equipado en dos perfiles a la vez.
///
/// Consistencia (cuenta, propiedad activa, definición activa/pública,
/// perfil ACTIVE) reforzada por trigger
/// (`enforce_equipped_title_account_consistency`) -- respaldo real en
/// base de datos, no solo en la aplicación (Gates 13/14). Precisión
/// obligatoria del Product Owner: el trigger exige
/// `public_profile.lifecycle_status = ACTIVE` pero NO exige
/// `visibility_status = VISIBLE` -- un perfil `PRIVATE` puede equipar y
/// conservar el título, simplemente no lo expone (mecanismo ya existente
/// de ADR-0018, ninguna superficie pública muestra nada sin
/// `visibilityStatus = VISIBLE`).
///
/// SIN trigger de inmutabilidad/no-DELETE (a diferencia de
/// `xp_ledger_entry`/`reward_grant_component`): des-equipar (elegir
/// "ningún título") y el borrado por anonimización (§4.10) son
/// operaciones legítimas de esta tabla.
model EquippedTitle {
  publicProfileId String   @id @map("public_profile_id") @db.Uuid
  accountTitleId  String   @unique @map("account_title_id") @db.Uuid
  equippedAt      DateTime @map("equipped_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  publicProfile PublicProfile @relation(fields: [publicProfileId], references: [id], onDelete: Restrict)
  accountTitle  AccountTitle  @relation(fields: [accountTitleId], references: [id], onDelete: Restrict)

  @@map("equipped_title")
}

/// Bloque III, Incremento 4, sub-incremento 4.a ("Fundación de
/// persistencia") -- ver docs/adr/BLOCK-III-DEFINITION.md §4.8/§4.12-§4.14
/// (Incremento 4) y ADR-0019 (mecanismo de entrega genérico, reutilizado,
/// no rediseñado). Data Model §16.18. SOLO esquema/repositorios mínimos en
/// 4.a -- SIN evaluación de eventos, SIN progresión, SIN reclamación de
/// recompensa, SIN integración con `RewardEvaluationWorker` (sub-incrementos
/// posteriores).
///
/// `challengeType` deliberadamente limitado a `DAILY`/`WEEKLY` -- Data
/// Model §16.18 admite además "temporada" y "permanente", pero
/// BLOCK-III-DEFINITION.md §1 restringe el alcance de este bloque a
/// diario/semanal; temporada se solapa con `game_season` (§16.19, Bloque
/// IV) y "permanente" no tiene regla de recurrencia definida en ningún
/// documento -- quedan fuera hasta que un bloque futuro los necesite.
///
/// Inmutable por fila una vez que existe un `account_challenge` que la
/// referencia (§4.8) -- SIN trigger de base de datos: se aplica igual que
/// `TitleDefinition`/`AchievementDefinition`, no exponiendo
/// `update()`/`delete()` en el repositorio. Un desafío recurrente o con
/// criterio actualizado es siempre una fila nueva (mismo `challengeKey`,
/// id distinto, ventana propia).
///
/// `eligibilityRule`/`completionRule`: `String` abierto, SIN gramática
/// interpretable todavía -- mismo criterio que `AchievementVersion.unlockRule`
/// antes de que 2.b definiera `XP_THRESHOLD`; la gramática de evaluación de
/// desafíos es responsabilidad de un sub-incremento posterior.
/// `rewardBundleId` nullable -- mismo criterio que
/// `AchievementVersion.rewardBundleId` (no todo desafío necesita configurar
/// ya su recompensa en 4.a).
model ChallengeDefinition {
  id              String                    @id @default(uuid()) @db.Uuid
  challengeKey    String                    @unique @map("challenge_key")
  name            String
  description     String?
  challengeType   ChallengeType             @map("challenge_type")
  eligibilityRule String                    @map("eligibility_rule")
  completionRule  String                    @map("completion_rule")
  rewardBundleId  String?                   @map("reward_bundle_id") @db.Uuid
  startsAt        DateTime                  @map("starts_at")
  endsAt          DateTime                  @map("ends_at")
  /// Tope de contribuciones válidas por fecha local de cuenta -- §4.12.
  /// NULL = sin tope adicional más allá de `targetValue`.
  dailyCap        Int?                      @map("daily_cap")
  status          ChallengeDefinitionStatus @default(ACTIVE)
  createdAt       DateTime                  @default(now()) @map("created_at")
  retiredAt       DateTime?                 @map("retired_at")

  rewardBundle      RewardBundle?      @relation(fields: [rewardBundleId], references: [id], onDelete: Restrict)
  accountChallenges AccountChallenge[]

  @@index([rewardBundleId])
  @@map("challenge_definition")
}

enum ChallengeType {
  DAILY
  WEEKLY

  @@map("challenge_type")
}

enum ChallengeDefinitionStatus {
  ACTIVE
  RETIRED

  @@map("challenge_definition_status")
}

/// §16.18. `periodStart`/`periodEnd` son SNAPSHOT de
/// `challengeDefinition.startsAt`/`endsAt` en el momento de creación --
/// mismo criterio de snapshot que `reward_grant_component` (ADR-0019
/// §4.5): aunque `challenge_definition` ya es inmutable por fila (§4.8), la
/// columna evita un JOIN para la unicidad y para consultas por período.
/// `acceptedAt` NUNCA es una acción voluntaria del estudiante en este
/// bloque -- es el instante de asignación automática (§4.14); el nombre de
/// columna sigue al Data Model, no a su semántica original.
///
/// Creación perezosa (§4.14): ningún proceso pre-crea filas para toda
/// cuenta elegible -- nace al abrir la sección de desafíos o al primer
/// evento elegible del período (mecanismo real: sub-incremento posterior;
/// 4.a solo expone `createIdempotent`).
///
/// Ciclo de vida sin saltos (Gate 17) reforzado por trigger
/// (`enforce_account_challenge_status_transition`): únicamente
/// `ACCEPTED -> IN_PROGRESS -> COMPLETED -> CLAIMED`, en ese orden, sin
/// omitir pasos ni retroceder. `completedAt`/`claimedAt` inmutables una vez
/// fijados (mismo criterio no punitivo que `reward_grant_component.deliveredAt`).
model AccountChallenge {
  id                    String                 @id @default(uuid()) @db.Uuid
  accountId             String                 @map("account_id") @db.Uuid
  challengeDefinitionId String                 @map("challenge_definition_id") @db.Uuid
  progressValue         Int                    @default(0) @map("progress_value")
  targetValue           Int                    @map("target_value")
  challengeStatus       AccountChallengeStatus @default(ACCEPTED) @map("challenge_status")
  periodStart           DateTime               @map("period_start")
  periodEnd             DateTime               @map("period_end")
  acceptedAt            DateTime               @map("accepted_at")
  completedAt           DateTime?              @map("completed_at")
  claimedAt             DateTime?              @map("claimed_at")
  updatedAt             DateTime               @updatedAt @map("updated_at")

  challengeDefinition ChallengeDefinition             @relation(fields: [challengeDefinitionId], references: [id], onDelete: Restrict)
  dailyProgress       AccountChallengeDailyProgress[]
  /// Bloque III, sub-incremento 4.b -- lado inverso de AccountChallengeConsumedEvent.accountChallengeId.
  consumedEvents      AccountChallengeConsumedEvent[]

  @@unique([accountId, challengeDefinitionId, periodStart])
  @@index([challengeDefinitionId])
  @@map("account_challenge")
}

enum AccountChallengeStatus {
  ACCEPTED
  IN_PROGRESS
  COMPLETED
  CLAIMED

  @@map("account_challenge_status")
}

/// §4.12 (BLOCK-III-DEFINITION.md) -- acumulado de contribuciones válidas
/// por día calendario UTC (`local_date` -- nombre de columna heredado de la
/// redacción original de §4.12, corregida en §4.16(a): NO es zona horaria
/// de cuenta, es UTC, mismo criterio que `XpRule.dailyCap`/racha --
/// `UserProfile.timezone` no es alcanzable desde GAMIFICATION sin una
/// dependencia circular de módulos). Divergencia deliberada respecto de
/// `XpRule.dailyCap` (ese mecanismo suma montos ya otorgados en un rango
/// UTC fijo sin tabla propia; este necesita un contador explícito por
/// fecha porque las contribuciones de un desafío son eventos discretos
/// acumulados a lo largo de un período de varios días, no un monto
/// sumable retroactivamente). 4.a SOLO expuso el primitivo de persistencia
/// (`upsertContribution`) -- 4.b decide elegibilidad, verifica `daily_cap`,
/// y propaga a `AccountChallenge.progressValue` (§4.16).
model AccountChallengeDailyProgress {
  id                 String   @id @default(uuid()) @db.Uuid
  accountChallengeId String   @map("account_challenge_id") @db.Uuid
  localDate          DateTime @map("local_date") @db.Date
  contributionCount  Int      @default(0) @map("contribution_count")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  accountChallenge AccountChallenge @relation(fields: [accountChallengeId], references: [id], onDelete: Restrict)

  @@unique([accountChallengeId, localDate])
  @@map("account_challenge_daily_progress")
}

/// §4.16 (BLOCK-III-DEFINITION.md), sub-incremento 4.b -- deduplicación por
/// evento, independiente del `daily_cap` (§4.12/§4.16(e)). Un evento
/// consumido lo está para siempre respecto de ESE `account_challenge`,
/// incluso si su contribución quedó bloqueada por `daily_cap` -- "consumido"
/// y "contribuyó" son hechos independientes (§4.16(e)). `UNIQUE
/// (account_challenge_id, xp_ledger_entry_id)` ES la clave idempotente --
/// mismo criterio que `account_title (accountId, titleDefinitionId)`, sin
/// columna de texto adicional. Sin trigger de inmutabilidad/no-DELETE: esta
/// tabla es de solo-inserción por diseño de aplicación (el worker nunca
/// actualiza ni borra una fila), no hay necesidad de reforzarlo en base de
/// datos todavía -- mismo criterio de proporcionalidad que `equipped_title`.
model AccountChallengeConsumedEvent {
  id                 String   @id @default(uuid()) @db.Uuid
  accountChallengeId String   @map("account_challenge_id") @db.Uuid
  xpLedgerEntryId    String   @map("xp_ledger_entry_id") @db.Uuid
  consumedAt         DateTime @default(now()) @map("consumed_at")

  accountChallenge AccountChallenge @relation(fields: [accountChallengeId], references: [id], onDelete: Restrict)
  xpLedgerEntry    XpLedgerEntry    @relation(fields: [xpLedgerEntryId], references: [id], onDelete: Restrict)

  @@unique([accountChallengeId, xpLedgerEntryId])
  @@map("account_challenge_consumed_event")
}

/// Bloque III, Incremento 5, sub-incremento 5.a ("Fundación de persistencia
/// y entrega de cosméticos") -- ver docs/adr/BLOCK-III-DEFINITION.md
/// §4.15/§4.19 y ADR-0019 (mecanismo de entrega genérico, reutilizado, no
/// rediseñado). Data Model §16.33. SOLO esquema/repositorios/entrega en
/// 5.a -- SIN `equipped_cosmetic`, SIN endpoints, SIN superficie móvil (ver
/// 5.b/5.c).
///
/// `itemType` usa el enum `CosmeticSlot` (§4.15) -- el mismo enum que
/// `EquippedCosmetic.cosmeticSlot` usará en 5.b; la coincidencia exacta
/// entre ambos (Gate 34) es justamente por qué comparten un único tipo.
///
/// `rarityClass`: String abierto, mismo criterio que
/// `TitleDefinition.rarityClass` (Data Model §16.33: "clasificación visual
/// o de disponibilidad. No implicará probabilidades ocultas" -- no una
/// enumeración cerrada).
///
/// `assetReference`: String OPACO a propósito (§4.19) -- 5.a no lo
/// interpreta como URL pública, ruta local ni clave de Object Storage;
/// solo lo persiste tal cual hasta que exista un contrato específico para
/// servir el asset.
///
/// Inmutable por diseño de repositorio (sin `update()`/`delete()`), mismo
/// criterio que `TitleDefinitionRepository`.
model CosmeticItem {
  id               String                   @id @default(uuid()) @db.Uuid
  itemKey          String                   @unique @map("item_key")
  itemType         CosmeticSlot             @map("item_type")
  name             String
  description      String?
  rarityClass      String                   @map("rarity_class")
  assetReference   String                   @map("asset_reference")
  visibilityStatus CosmeticVisibilityStatus @map("visibility_status")
  status           CosmeticItemStatus       @default(ACTIVE)
  createdAt        DateTime                 @default(now()) @map("created_at")
  retiredAt        DateTime?                @map("retired_at")

  inventoryItems InventoryItem[]

  @@map("cosmetic_item")
}

/// §4.15 -- mismo enum para `CosmeticItem.itemType` y (5.b)
/// `EquippedCosmetic.cosmeticSlot`. `TITLE` deliberadamente ausente: los
/// títulos siguen exclusivamente en `equipped_title` (Incremento 3, Gate 35).
enum CosmeticSlot {
  AVATAR
  AVATAR_FRAME
  PROFILE_BANNER
  BADGE

  @@map("cosmetic_slot")
}

enum CosmeticVisibilityStatus {
  PRIVATE
  PUBLIC

  @@map("cosmetic_visibility_status")
}

enum CosmeticItemStatus {
  ACTIVE
  RETIRED

  @@map("cosmetic_item_status")
}

/// Estructura calcada de `account_title` (§4.19) -- Data Model §16.34.
/// `acquisitionSourceType`/`acquisitionSourceId` son SNAPSHOT del
/// `reward_grant` que entregó este cosmético (mismo criterio que
/// `AccountTitle`, ADR-0019 §4.5) -- fuente AUTORITATIVA de adquisición,
/// nunca un metadato del catálogo. `UNIQUE(accountId, cosmeticItemId)` --
/// idempotencia de adquisición (Data Model: "Un artículo único no deberá
/// duplicarse accidentalmente").
///
/// `ownershipStatus`: 5.a produce ÚNICAMENTE `ACTIVE` en la creación --
/// `REVOKED`/`SUPERSEDED` quedan reservados para una herramienta de
/// moderación futura (mismo criterio que `AccountTitle`). Precisión
/// obligatoria del Product Owner (§4.19): una nueva entrega del mismo
/// cosmético sobre una fila ya no `ACTIVE` NUNCA reactiva su
/// `ownershipStatus` -- `InventoryItemRepository.createIdempotent` la
/// devuelve tal cual, sin tocarla; reactivar propiedad revocada es una
/// política de dominio no definida, fuera de alcance de 5.a.
model InventoryItem {
  id                    String                       @id @default(uuid()) @db.Uuid
  accountId             String                       @map("account_id") @db.Uuid
  cosmeticItemId        String                       @map("cosmetic_item_id") @db.Uuid
  acquisitionSourceType RewardSourceEntityType       @map("acquisition_source_type")
  acquisitionSourceId   String                       @map("acquisition_source_id")
  acquiredAt            DateTime                     @map("acquired_at")
  ownershipStatus       InventoryItemOwnershipStatus @default(ACTIVE) @map("ownership_status")
  revokedAt             DateTime?                    @map("revoked_at")

  cosmeticItem      CosmeticItem       @relation(fields: [cosmeticItemId], references: [id], onDelete: Restrict)
  /// Bloque III, sub-incremento 5.b -- lado inverso de EquippedCosmetic.inventoryItemId.
  equippedCosmetics EquippedCosmetic[]

  @@unique([accountId, cosmeticItemId])
  @@map("inventory_item")
}

enum InventoryItemOwnershipStatus {
  ACTIVE
  REVOKED
  SUPERSEDED

  @@map("inventory_item_ownership_status")
}

/// Bloque III, Incremento 5, sub-incremento 5.b ("Equipamiento de
/// cosméticos") -- ver docs/adr/BLOCK-III-DEFINITION.md (Incremento 5) y
/// ADR-0018 (public_profile). Data Model §16.35. Estructura calcada de
/// `equipped_title` (3.b), extendida a multi-slot (decisión ya fijada en
/// §4.10): `@@id([publicProfileId, cosmeticSlot])`, no `publicProfileId`
/// solo -- una cuenta puede tener varias filas simultáneas (una por slot).
///
/// `inventoryItemId` SIN `@unique` -- a diferencia de
/// `EquippedTitle.accountTitleId`, no hace falta: la coincidencia estricta
/// `cosmetic_item.item_type = cosmetic_slot` (trigger, Gate 34) ya
/// garantiza que un `inventory_item` solo puede ocupar SU slot
/// correspondiente.
///
/// Consistencia (cuenta, propiedad activa, perfil ACTIVE, Y coincidencia
/// de tipo-slot) reforzada por trigger
/// (`enforce_equipped_cosmetic_account_consistency`) -- respaldo real en
/// base de datos, no solo en la aplicación (Gates 22/34/62/63). Mismo
/// criterio que `equipped_title`: el trigger exige
/// `public_profile.lifecycle_status = ACTIVE` pero NO `visibility_status =
/// VISIBLE`.
///
/// `upsert` sobre la PK es la única operación de escritura con sentido
/// (equipar = reemplazar la selección de ESE slot, nunca "añadir") --
/// re-equipar el mismo cosmético o reemplazar el del slot son ambos un
/// único `UPDATE` atómico (Gates 59/60/66). SIN protección de
/// inmutabilidad: cambiar de selección y la limpieza por anonimización
/// (§4.20, `PublicProfileRepository.anonymize`) son operaciones legítimas.
model EquippedCosmetic {
  publicProfileId String       @map("public_profile_id") @db.Uuid
  cosmeticSlot    CosmeticSlot @map("cosmetic_slot")
  inventoryItemId String       @map("inventory_item_id") @db.Uuid
  equippedAt      DateTime     @map("equipped_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  publicProfile PublicProfile @relation(fields: [publicProfileId], references: [id], onDelete: Restrict)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Restrict)

  @@id([publicProfileId, cosmeticSlot])
  @@map("equipped_cosmetic")
}

// =============================================================================
// Bloque IV, Incremento 1 -- Fundación de temporadas y ligas.
// Ver docs/adr/LEF-BLOCK-IV-DEFINITION.md §9 (diseño detallado, confirmado
// con cuatro precisiones obligatorias del Product Owner). Data Model
// §16.19-16.22. Sin ranking (Incremento 2), sin endpoints, sin móvil.
//
// `timezonePolicy` de Data Model §16.19 se omite deliberadamente: superseded
// por la convención ya fijada en Bloque III (calendario UTC exclusivamente,
// nunca zona horaria de cuenta, para no introducir una dependencia circular
// con USER) -- no es un vacío, es una resolución explícita.
//
// `rankingRuleVersion`/`rewardPolicyVersion` (game_season) y
// `minimumEntryRule`/`promotionRule`/`demotionRule`/`rewardBundleId`
// (league_definition) se incluyen como columnas abiertas (String/UUID
// nullable) siguiendo el mismo criterio ya usado para
// `ChallengeDefinition.eligibilityRule`/`completionRule` en Bloque III
// 4.a: el campo existe desde el nacimiento del modelo (Data Model lo exige),
// pero NINGÚN código de este incremento las lee ni las interpreta -- eso es
// responsabilidad de Incremento 2 (ranking/ascenso-descenso) y de quien
// conecte la entrega de recompensas de liga. Evita una migración adicional
// para añadir columnas que Data Model ya nombra como parte de la entidad.
// =============================================================================

enum GameSeasonStatus {
  SCHEDULED
  ACTIVE
  FINALIZED
  ARCHIVED

  @@map("game_season_status")
}

/// Data Model §16.19. Fila inmutable por temporada -- nunca se edita una ya
/// creada salvo su `status` (transición forward-only, trigger) y
/// `finalizedAt`. Invariante "una sola temporada ACTIVE a la vez" reforzada
/// por índice único parcial (migración SQL, no expresable en `schema.prisma`).
model GameSeason {
  id                  String           @id @default(uuid()) @db.Uuid
  seasonKey           String           @unique @map("season_key")
  name                String
  description         String?
  startsAt            DateTime         @map("starts_at")
  endsAt              DateTime         @map("ends_at")
  /// Grammar abierta, interpretada por Incremento 2 -- ver nota de cabecera.
  rankingRuleVersion  String?          @map("ranking_rule_version")
  rewardPolicyVersion String?          @map("reward_policy_version")
  status              GameSeasonStatus @default(SCHEDULED)
  createdAt           DateTime         @default(now()) @map("created_at")
  finalizedAt         DateTime?        @map("finalized_at")

  leagueGroups   LeagueGroup[]
  participations SeasonLeagueParticipation[]

  @@map("game_season")
}

enum LeagueDefinitionStatus {
  ACTIVE
  RETIRED

  @@map("league_definition_status")
}

/// Data Model §16.20. Plantilla de TIER (ej. "Bronce") -- inmutable por fila,
/// mismo criterio que ChallengeDefinition/TitleDefinition: una regla nueva es
/// una fila nueva. NO es la instancia donde compiten los estudiantes -- ver
/// LeagueGroup.
model LeagueDefinition {
  id                   String                 @id @default(uuid()) @db.Uuid
  leagueKey            String                 @unique @map("league_key")
  name                 String
  tierOrder            Int                    @map("tier_order")
  /// Grammar abierta, interpretada por Incremento 2 -- ver nota de cabecera.
  minimumEntryRule     String?                @map("minimum_entry_rule")
  promotionRule        String?                @map("promotion_rule")
  demotionRule         String?                @map("demotion_rule")
  participantGroupSize Int                    @map("participant_group_size")
  rewardBundleId       String?                @map("reward_bundle_id") @db.Uuid
  status               LeagueDefinitionStatus @default(ACTIVE)
  createdAt            DateTime               @default(now()) @map("created_at")
  retiredAt            DateTime?              @map("retired_at")

  rewardBundle   RewardBundle?               @relation(fields: [rewardBundleId], references: [id], onDelete: Restrict)
  leagueGroups   LeagueGroup[]
  participations SeasonLeagueParticipation[]

  @@index([rewardBundleId])
  @@map("league_definition")
}

enum LeagueGroupStatus {
  /// Acepta inscripciones (cupo disponible).
  OPEN
  /// Cupo alcanzado -- sigue acumulando puntos hasta el cierre de temporada.
  FULL
  /// Temporada cerrada -- sin inscripciones, sin acumulación de puntos.
  LOCKED
  /// Incremento 2 calculó rangos/ascensos -- fuera del alcance de este incremento.
  FINALIZED

  @@map("league_group_status")
}

/// Data Model §16.21. INSTANCIA real y acotada de un tier para una temporada
/// -- el conjunto de estudiantes que compiten entre sí. Materializada
/// perezosamente (§9.3) bajo advisory lock (namespace 21) para proteger su
/// `capacity` bajo concurrencia real -- ver trigger
/// `enforce_league_group_capacity` (defensa adicional a nivel de base de
/// datos, en caso de que algún camino futuro omita el lock).
model LeagueGroup {
  id                      String            @id @default(uuid()) @db.Uuid
  gameSeasonId            String            @map("game_season_id") @db.Uuid
  leagueDefinitionId      String            @map("league_definition_id") @db.Uuid
  groupNumber             Int               @map("group_number")
  /// Snapshot de `LeagueDefinition.participantGroupSize` al crear el grupo --
  /// mismo criterio que `AccountChallenge.periodStart/periodEnd` snapshot de
  /// `ChallengeDefinition`: el cupo de un grupo ya creado nunca cambia
  /// retroactivamente si la definición del tier se reemplaza después.
  capacity                Int
  assignmentPolicyVersion String            @map("assignment_policy_version")
  status                  LeagueGroupStatus @default(OPEN)
  createdAt               DateTime          @default(now()) @map("created_at")
  lockedAt                DateTime?         @map("locked_at")
  finalizedAt             DateTime?         @map("finalized_at")

  gameSeason       GameSeason                  @relation(fields: [gameSeasonId], references: [id], onDelete: Restrict)
  leagueDefinition LeagueDefinition            @relation(fields: [leagueDefinitionId], references: [id], onDelete: Restrict)
  participations   SeasonLeagueParticipation[]

  @@unique([gameSeasonId, leagueDefinitionId, groupNumber])
  @@map("league_group")
}

enum SeasonLeagueParticipationStatus {
  ACTIVE
  /// Estado terminal de ESTE incremento -- Incremento 2 decide
  /// PROMOTED/DEMOTED/RETAINED a partir de aquí, no este.
  SEASON_ENDED

  @@map("season_league_participation_status")
}

/// Data Model §16.20. Vínculo cuenta<->grupo para una temporada. `@@unique
/// ([accountId, gameSeasonId])` -- una cuenta nunca tiene dos participaciones
/// activas en la misma temporada (§9.3). Inscripción idempotente: check-antes
/// -de-crear, mismo criterio que AccountChallengeRepository.createIdempotent
/// (corregido en Bloque III 4.b).
model SeasonLeagueParticipation {
  id                  String                          @id @default(uuid()) @db.Uuid
  gameSeasonId        String                          @map("game_season_id") @db.Uuid
  accountId           String                          @map("account_id") @db.Uuid
  leagueDefinitionId  String                          @map("league_definition_id") @db.Uuid
  leagueGroupId       String                          @map("league_group_id") @db.Uuid
  leaguePoints        Int                             @default(0) @map("league_points")
  /// Incremento 2 lo calcula -- NULL hasta entonces.
  currentRank         Int?                            @map("current_rank")
  participationStatus SeasonLeagueParticipationStatus @default(ACTIVE) @map("participation_status")
  joinedAt            DateTime                        @map("joined_at")
  /// Incremento 2 lo calcula -- NULL hasta entonces.
  finalRank           Int?                            @map("final_rank")
  finalizedAt         DateTime?                       @map("finalized_at")

  gameSeason       GameSeason               @relation(fields: [gameSeasonId], references: [id], onDelete: Restrict)
  leagueDefinition LeagueDefinition         @relation(fields: [leagueDefinitionId], references: [id], onDelete: Restrict)
  leagueGroup      LeagueGroup              @relation(fields: [leagueGroupId], references: [id], onDelete: Restrict)
  ledgerEntries    LeaguePointLedgerEntry[]

  @@unique([accountId, gameSeasonId])
  @@index([leagueGroupId])
  @@map("season_league_participation")
}

enum LeaguePointRuleStatus {
  ACTIVE
  RETIRED

  @@map("league_point_rule_status")
}

/// Fuente autoritativa del MONTO de League Points -- decisión exclusiva del
/// servidor (§9.4), nunca una copia/conversión de XpRule. Selección de regla
/// vigente por `effectiveFrom`, mismo criterio que XpRule -- simplificada sin
/// la capa de GamificationProgram/ProgramVersion (innecesaria: un solo
/// "programa" de puntos de liga en V1, a diferencia de XP que ya soportaba
/// múltiples programas desde su diseño original).
model LeaguePointRule {
  id             String                @id @default(uuid()) @db.Uuid
  /// Abierto -- mismo criterio que ValidatedGamificationActivity.activityType.
  activityType   String                @map("activity_type")
  basePoints     Int                   @map("base_points")
  dailyCap       Int?                  @map("daily_cap")
  effectiveFrom  DateTime              @map("effective_from")
  effectiveUntil DateTime?             @map("effective_until")
  ruleVersion    String                @map("rule_version")
  status         LeaguePointRuleStatus @default(ACTIVE)
  createdAt      DateTime              @default(now()) @map("created_at")

  ledgerEntries LeaguePointLedgerEntry[]

  @@map("league_point_rule")
}

enum LeaguePointLedgerEntryType {
  OTORGAMIENTO
  REVERSO
  AJUSTE

  @@map("league_point_ledger_entry_type")
}

/// Ledger INDEPENDIENTE de xp_ledger_entry (§4.4/§9.7 -- nunca una vista
/// derivada, nunca una transacción compartida). Idempotencia vincula
/// actividad Y participación (§9.5, precisión obligatoria del Product
/// Owner): `idempotencyKey = "league-grant:{participationId}:{validatedActivityId}"`,
/// con ambas referencias conservadas como columnas propias (no solo
/// codificadas en la clave) para poder auditar exactamente qué actividad y
/// qué participación produjeron cada fila. Inmutable + reverso como fila
/// nueva, mismos dos triggers que xp_ledger_entry (migración SQL).
model LeaguePointLedgerEntry {
  id                          String                     @id @default(uuid()) @db.Uuid
  accountId                   String                     @map("account_id") @db.Uuid
  seasonLeagueParticipationId String                     @map("season_league_participation_id") @db.Uuid
  validatedActivityId         String?                    @map("validated_activity_id") @db.Uuid
  leaguePointRuleId           String?                    @map("league_point_rule_id") @db.Uuid
  entryType                   LeaguePointLedgerEntryType @map("entry_type")
  pointAmount                 Int                        @map("point_amount")
  ruleVersion                 String?                    @map("rule_version")
  idempotencyKey              String                     @unique @map("idempotency_key")
  occurredAt                  DateTime                   @map("occurred_at")
  recordedAt                  DateTime                   @default(now()) @map("recorded_at")
  reversesEntryId             String?                    @unique @map("reverses_entry_id") @db.Uuid

  seasonLeagueParticipation SeasonLeagueParticipation      @relation(fields: [seasonLeagueParticipationId], references: [id], onDelete: Restrict)
  validatedActivity         ValidatedGamificationActivity? @relation(fields: [validatedActivityId], references: [id], onDelete: Restrict)
  leaguePointRule           LeaguePointRule?               @relation(fields: [leaguePointRuleId], references: [id], onDelete: Restrict)
  reversesEntry             LeaguePointLedgerEntry?        @relation("LeaguePointLedgerEntryReversal", fields: [reversesEntryId], references: [id], onDelete: Restrict)
  reversedBy                LeaguePointLedgerEntry?        @relation("LeaguePointLedgerEntryReversal")

  @@index([accountId])
  @@index([seasonLeagueParticipationId])
  @@map("league_point_ledger_entry")
}
