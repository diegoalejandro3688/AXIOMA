# Copiar a .env para desarrollo local (nunca commitear .env real).
# Debe coincidir con las credenciales de docker-compose.yml para el entorno "dev".
DATABASE_URL="postgresql://axioma:axioma_dev_password@localhost:5432/axioma_dev?schema=public"

# staging y production usan su propia DATABASE_URL, inyectada por el gestor de
# secretos del entorno correspondiente -- nunca en este archivo ni en el repo.

# AUTH_IDENTITY_PROVIDER=firebase (default) usa Firebase real -- requiere
# FIREBASE_SERVICE_ACCOUNT_JSON (el JSON de la cuenta de servicio, como string
# de una sola linea). AUTH_IDENTITY_PROVIDER=stub usa un proveedor falso para
# desarrollo/pruebas locales sin proyecto Firebase -- NUNCA permitido si
# NODE_ENV=production (el modulo lo rechaza explicitamente).
AUTH_IDENTITY_PROVIDER=firebase
FIREBASE_SERVICE_ACCOUNT_JSON=

# Clave compartida para endpoints operativos internos (ej. disparar barridos
# de Privacy manualmente vía X-Internal-Ops-Key). Generar un valor aleatorio
# largo por ambiente -- nunca reutilizar el mismo valor entre dev/staging/prod.
INTERNAL_OPS_KEY=

# ANALYTICS (ver ADR-0006). Secreto usado para derivar analyticsActorRef
# (HMAC-SHA256 de accountId) -- generar un valor aleatorio largo por
# ambiente, nunca reutilizar entre dev/staging/prod. Si falta, los eventos
# se ingieren igual pero sin actor pseudónimo (nunca con el accountId crudo).
ANALYTICS_ACTOR_SECRET=

# Identificador de versión del backend, propagado como producerVersion en
# los eventos publicados al outbox -- trazabilidad entre despliegues. En
# CI/producción, fijar al SHA corto del commit o al semver del release.
PRODUCER_VERSION=dev

# OBSERVABILIDAD (ver ADR-0007).
# Nivel mínimo de log emitido: verbose|debug|log|warn|error|fatal. Default: log.
LOG_LEVEL=log
# appVersion incluido en cada línea de log. Si falta, cae a la versión de
# package.json y, si tampoco existe, a "unknown". En CI/producción, fijar
# al mismo valor que PRODUCER_VERSION (SHA corto o semver del release).
APP_VERSION=dev

# ALMACENAMIENTO DE OBJETOS (ver ADR-0010). Protocolo S3-compatible -- en
# dev/CI apunta a MinIO (docker-compose); Cloudflare R2 (elegido en el
# Decision Gate) todavía NO está aprovisionado -- cuando se decida, solo
# cambian estas variables, no el código.
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=axioma-content-dev
OBJECT_STORAGE_ACCESS_KEY_ID=axioma
OBJECT_STORAGE_SECRET_ACCESS_KEY=axioma_dev_password
# Límites de subida -- NUNCA fijos en código, siempre configurables.
OBJECT_STORAGE_MAX_FILE_SIZE_BYTES=5242880
OBJECT_STORAGE_MAX_WIDTH_PX=4000
OBJECT_STORAGE_MAX_HEIGHT_PX=4000

# TUTOR IA (ver docs/adr/LEF-BLOCK-VI-DEFINITION.md, ADR-0022, Incremento 2).
# AI_PROVIDER_IMPL=fake (default) usa FakeAiProvider -- determinista, sin red,
# usado por el gate ordinario y en desarrollo sin credenciales. =anthropic usa
# el proveedor real (AnthropicAiProvider) contra la API de Anthropic --
# requiere ANTHROPIC_API_KEY.
AI_PROVIDER_IMPL=fake
# Clave de API de Anthropic. NUNCA commitear un valor real -- generar por
# ambiente, nunca reutilizar entre dev/staging/prod.
ANTHROPIC_API_KEY=
# Modelo productivo fijado por ADR-0022 (Gate C5). Configurable por entorno
# únicamente para operación/despliegue -- el cliente (mobile) nunca puede
# elegir ni influir el modelo usado.
ANTHROPIC_MODEL=claude-sonnet-5
# Presupuesto TOTAL (wall-clock) de la operación de generación, en
# milisegundos -- incluye el intento inicial Y el reintento técnico (máximo
# 1), nunca se reinicia entre intentos. Decisión del Product Owner: 8000.
ANTHROPIC_TIMEOUT_MS=8000
# Límite de tokens de salida -- GUARDRAIL TÉCNICO PROVISIONAL del Incremento 2
# para la integración real y su gate, NO la política contractual definitiva
# de tokens/coste de Tutor V1 (eso pertenece al Incremento 3). El cliente
# (mobile) nunca puede elegir este valor.
ANTHROPIC_MAX_OUTPUT_TOKENS=512
