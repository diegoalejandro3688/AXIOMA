# Copiar a .env para desarrollo local (nunca commitear .env real).
# Debe coincidir con las credenciales de docker-compose.yml para el entorno "dev".
DATABASE_URL="postgresql://axioma:axioma_dev_password@localhost:5432/axioma_dev?schema=public"

# staging y production usan su propia DATABASE_URL, inyectada por el gestor de
# secretos del entorno correspondiente -- nunca en este archivo ni en el repo.

# AUTH_IDENTITY_PROVIDER=firebase (default) usa Firebase real -- requiere
# FIREBASE_SERVICE_ACCOUNT_JSON (el JSON de la cuenta de servicio, como string
# de una sola linea). AUTH_IDENTITY_PROVIDER=stub usa un proveedor falso para
# desarrollo/pruebas locales sin proyecto Firebase -- NUNCA permitido si
# NODE_ENV=production (el modulo lo rechaza explicitamente).
AUTH_IDENTITY_PROVIDER=firebase
FIREBASE_SERVICE_ACCOUNT_JSON=

# Clave compartida para endpoints operativos internos (ej. disparar barridos
# de Privacy manualmente vía X-Internal-Ops-Key). Generar un valor aleatorio
# largo por ambiente -- nunca reutilizar el mismo valor entre dev/staging/prod.
INTERNAL_OPS_KEY=
