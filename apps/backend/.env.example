# Copiar a .env para desarrollo local (nunca commitear .env real).
# Debe coincidir con las credenciales de docker-compose.yml para el entorno "dev".
DATABASE_URL="postgresql://axioma:axioma_dev_password@localhost:5432/axioma_dev?schema=public"

# staging y production usan su propia DATABASE_URL, inyectada por el gestor de
# secretos del entorno correspondiente -- nunca en este archivo ni en el repo.

# AUTH_IDENTITY_PROVIDER=firebase (default) usa Firebase real -- requiere
# FIREBASE_SERVICE_ACCOUNT_JSON (el JSON de la cuenta de servicio, como string
# de una sola linea). AUTH_IDENTITY_PROVIDER=stub usa un proveedor falso para
# desarrollo/pruebas locales sin proyecto Firebase -- NUNCA permitido si
# NODE_ENV=production (el modulo lo rechaza explicitamente).
AUTH_IDENTITY_PROVIDER=firebase
FIREBASE_SERVICE_ACCOUNT_JSON=

# Clave compartida para endpoints operativos internos (ej. disparar barridos
# de Privacy manualmente vía X-Internal-Ops-Key). Generar un valor aleatorio
# largo por ambiente -- nunca reutilizar el mismo valor entre dev/staging/prod.
INTERNAL_OPS_KEY=

# ANALYTICS (ver ADR-0006). Secreto usado para derivar analyticsActorRef
# (HMAC-SHA256 de accountId) -- generar un valor aleatorio largo por
# ambiente, nunca reutilizar entre dev/staging/prod. Si falta, los eventos
# se ingieren igual pero sin actor pseudónimo (nunca con el accountId crudo).
ANALYTICS_ACTOR_SECRET=

# GAMIFICATION (ver WEB-0D.1C-B1/B2). Secreto usado para derivar
# gamificationActorRef (HMAC-SHA256 de accountId) -- dominio de
# pseudonimización SEPARADO de ANALYTICS_ACTOR_SECRET, NUNCA el mismo
# valor ni derivado de él. A diferencia de ANALYTICS_ACTOR_SECRET, este es
# REQUERIDO para las escrituras nuevas afectadas (topic-completed/
# ensayo-completado/resource-completed, y las recompensas LEVEL/
# STUDY_SUBJECT/TITLE_UNLOCK): si falta, esas escrituras fallan
# explícitamente en vez de persistir accountId crudo. Generar un valor
# aleatorio largo por ambiente, nunca reutilizar entre dev/staging/prod.
GAMIFICATION_ACTOR_SECRET=

# F1-A.4 -- dominio de pseudonimización PROPIO de moderación/trust-and-safety
# (PublicProfileReport/AccountBlock). REQUERIDO para el cierre definitivo de
# cuenta: si falta, el barrido de cierre lanza y la PrivacyRequest queda
# PROCESSING para reintento -- nunca se marca CLOSED una cuenta con historial
# de moderación reteniendo su accountId directo. Nunca reutilizar el valor de
# GAMIFICATION_ACTOR_SECRET/ANALYTICS_ACTOR_SECRET ni entre dev/staging/prod.
MODERATION_ACTOR_SECRET=

# WEB-0D.1C-B4-R1 -- habilita el reconciliador ACOTADO de participaciones de
# liga CLOSED + terminales pendientes de desvinculacion de privacidad (red de
# seguridad horaria para los hooks de cierre/finalizacion de B4 cuando fallan
# de forma transitoria). OPCIONAL, deshabilitado por defecto -- solo el valor
# exacto `true` lo activa (ausente/`false`/cualquier otro valor = deshabilitado,
# nunca un fallback que lo active por accidente). Mantener en `false` hasta que
# la linea base legado/B5 este explicitamente aprobada -- antes de B4 nunca
# corrio ningun hook, asi que cualquier fila CLOSED+terminal+cruda que exista
# en produccion en ese momento es legado pre-B4, no un caso perdido real.
GAMIFICATION_PRIVACY_RECONCILER_ENABLED=false

# Identificador de versión del backend, propagado como producerVersion en
# los eventos publicados al outbox -- trazabilidad entre despliegues. En
# CI/producción, fijar al SHA corto del commit o al semver del release.
PRODUCER_VERSION=dev

# OBSERVABILIDAD (ver ADR-0007).
# Nivel mínimo de log emitido: verbose|debug|log|warn|error|fatal. Default: log.
LOG_LEVEL=log
# appVersion incluido en cada línea de log. Si falta, cae a la versión de
# package.json y, si tampoco existe, a "unknown". En CI/producción, fijar
# al mismo valor que PRODUCER_VERSION (SHA corto o semver del release).
APP_VERSION=dev

# ALMACENAMIENTO DE OBJETOS (ver ADR-0010). Protocolo S3-compatible -- en
# dev/CI apunta a MinIO (docker-compose); Cloudflare R2 (elegido en el
# Decision Gate) todavía NO está aprovisionado -- cuando se decida, solo
# cambian estas variables, no el código.
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_REGION=auto
OBJECT_STORAGE_BUCKET=axioma-content-dev
OBJECT_STORAGE_ACCESS_KEY_ID=axioma
OBJECT_STORAGE_SECRET_ACCESS_KEY=axioma_dev_password
# Límites de subida -- NUNCA fijos en código, siempre configurables.
OBJECT_STORAGE_MAX_FILE_SIZE_BYTES=5242880
OBJECT_STORAGE_MAX_WIDTH_PX=4000
OBJECT_STORAGE_MAX_HEIGHT_PX=4000

# TUTOR IA (ver docs/adr/LEF-BLOCK-VI-DEFINITION.md, ADR-0022, Incrementos 2-3).
# AI_PROVIDER_IMPL=fake (default) usa FakeAiProvider -- determinista, sin red,
# usado por el gate ordinario y en desarrollo sin credenciales. =anthropic usa
# el proveedor real (AnthropicAiProvider) contra la API de Anthropic --
# requiere ANTHROPIC_API_KEY.
AI_PROVIDER_IMPL=fake
# Clave de API de Anthropic. NUNCA commitear un valor real -- generar por
# ambiente, nunca reutilizar entre dev/staging/prod.
ANTHROPIC_API_KEY=
# Modelo productivo fijado por ADR-0022 (Gate C5). Configurable por entorno
# únicamente para operación/despliegue -- el cliente (mobile) nunca puede
# elegir ni influir el modelo usado.
ANTHROPIC_MODEL=claude-sonnet-5
# Presupuesto TOTAL (wall-clock) de la operación de generación, en
# milisegundos -- incluye el intento inicial Y el reintento técnico (máximo
# 1), nunca se reinicia entre intentos: NO es "10 s por intento", 10 s + 10 s
# no puede ocurrir. Decisión del Product Owner: subido de 8000 a 10000 con la
# evidencia real de la evaluación de AXIOMA_TUTOR_V4 (18,4 % de los turnos
# expiraron a 8002-8018 ms con un prompt de ~2.570 tokens de entrada; máximo
# registrado 7.990 ms, a 10 ms del deadline). No cambia el número de
# reintentos, ni las categorías reintentables (timeout NO es reintentable), ni
# la idempotencia, ni ninguna cuota. La otra mitad de la mitigación es la
# compresión semántica del prompt AXIOMA_TUTOR_V5.
ANTHROPIC_TIMEOUT_MS=10000
# Límite de tokens de salida -- política explícita y revisable (auditada en el
# Incremento 3, ver docstring de AnthropicAiProvider: coste/UX/3-50 consultas
# diarias/Sonnet 5). Subido de 512 a 768 tras la evaluación pedagógica real de
# AXIOMA_TUTOR_V3: 9 de 21 turnos (43 %) se cortaron exactamente en 512 tokens
# y uno de ellos (P19) quedó inutilizable. La otra mitad de la mitigación es la
# regla de brevedad/formato de chat del prompt AXIOMA_TUTOR_V4. Se MANTIENE en
# 768 en V5 (la corrida real de V4 midió 0 turnos truncados sobre 34 y un
# máximo de 570 tokens de salida). El cliente (mobile) nunca puede elegir este
# valor ni distinguirlo por tier.
ANTHROPIC_MAX_OUTPUT_TOKENS=768
# Cuotas/entitlements del Tutor IA (Incremento 3) -- ver AiEntitlementService.
# Frontera provisional: sin fuente real de suscripción, toda cuenta resuelve FREE
# (3 consultas/día, 6 turnos/conversación) hasta que exista un sistema de planes real.

# Circuit breaker operativo del Tutor IA (Incremento 3) -- ver AiCircuitBreakerService.
# =true bloquea TODA generación nueva (503 controlado, cero consumo) sin afectar
# el resto de Axioma. Alternable en caliente vía POST /ai/_internal/set-circuit-breaker
# (InternalOpsGuard, rechazado en producción) sin reiniciar el proceso.
AI_GENERATION_DISABLED=false

# PREMIUM V1 -- Capa 3 (Google Play Billing), C3.2.
# Setup real de los recursos Google (proyecto GCP, service accounts, topic
# Pub/Sub, License Testers): docs/adr/PREMIUM-V1-LAYER-3-GOOGLE-SETUP-RUNBOOK.md
# `fake` (default): adaptador determinista en memoria, sin credenciales ni red.
#   El desarrollo local normal usa este valor -- nunca requiere credenciales de Google.
# `google`: construye el adaptador real de la Google Play Developer API.
#   Requiere GOOGLE_PLAY_SERVICE_ACCOUNT_JSON. Se activa en C3.4B (tras el primer
#   upload de una build con Billing, C3.5A).
# `disabled` (RC1B.1 -- POSTURA CONGELADA): permite ARRANCAR con NODE_ENV=production
#   mientras Google Play Billing sigue congelado (sin Play Console). NO contacta
#   Google, NO verifica compras, NO concede PREMIUM, NO requiere credenciales;
#   toda reconciliacion devuelve 503. Debe ser EXPLICITO -- en produccion el impl
#   ausente o `fake` sigue haciendo que la factory LANCE al arrancar.
GOOGLE_PLAY_PROVIDER_IMPL=fake
# JSON completo de la service account con acceso de lectura a la Play Console.
# SOLO backend -- jamas en el repo, jamas en el movil, jamas en logs. Debe ser
# JSON valido con `client_email` y `private_key` (y `type` = "service_account"
# si viene). Sin valor / invalida con `GOOGLE_PLAY_PROVIDER_IMPL=google` -> la
# factory LANZA al arrancar (fail-fast, RC1B.1A), nunca una verificacion falsa.
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=

# PREMIUM V1 -- Capa 3 (Google Play Billing), C3.3 -- RTDN (Real-time Developer
# Notifications) via Google Cloud Pub/Sub push autenticado (OIDC).
# `fake` (default): verificador OIDC determinista en memoria, sin red -- local/gates.
# `google`: verifica el JWT del push con `google-auth-library` (certs publicos de Google).
#   En produccion con el impl ausente o `fake` -> la factory LANZA al arrancar (fail-closed).
# `disabled` (RC1B.1 -- POSTURA CONGELADA): arranca sin verificador OIDC y sin
#   GOOGLE_PLAY_RTDN_OIDC_AUDIENCE/..._EMAIL. RECHAZA todo push (401) y NO agenda
#   el worker del buzon. Debe ser EXPLICITO -- el impl ausente en produccion se rechaza.
GOOGLE_PLAY_RTDN_AUTH_IMPL=fake
# `aud` esperado en el token OIDC del push (normalmente la URL publica del endpoint
# `POST /internal/google-play/rtdn`). Sin esto en produccion / con impl=google -> fail-closed.
# GOOGLE_PLAY_RTDN_OIDC_AUDIENCE=https://api.zetrynd.app/internal/google-play/rtdn
# `email` de la service account que Google Cloud Pub/Sub usa para firmar el push.
# Sin esto en produccion / con impl=google -> fail-closed.
# GOOGLE_PLAY_RTDN_PUSH_SERVICE_ACCOUNT_EMAIL=zetrynd-rtdn-push@<project>.iam.gserviceaccount.com

# PB-1B -- retencion de datos de FACTURACION para cuentas cerradas. Numero
# ENTERO de dias desde que una fila `account_subscription` de una cuenta CLOSED
# alcanza estado terminal (EXPIRED/REVOKED/SUPERSEDED) antes de que el barrido
# la purgue (y limpie `Account.obfuscated_account_id` cuando ya no quedan
# filas). OPCIONAL. AUSENTE / vacia / invalida -> el barrido es NO-OP: se
# RETIENE, no se borra (direccion fail-safe). La duracion legal la fija la
# Politica de Privacidad / el titular legal (PB-6), NUNCA ingenieria -- no hay
# valor por defecto.
# BILLING_RETENTION_DAYS_AFTER_TERMINAL=

# RTDN-RET -- retencion del buzon durable `google_play_rtdn_event`. Numero
# ENTERO de dias desde que una fila alcanza estado TERMINAL (DONE/FAILED/
# IGNORED, via su `processed_at`) antes de que el barrido la purgue. OPCIONAL.
# AUSENTE / vacia / invalida -> el barrido es NO-OP: se RETIENE, no se borra
# (direccion fail-safe, mismo criterio que BILLING_RETENTION_DAYS_AFTER_TERMINAL
# -- RTDN es parte del dominio de FACTURACION, no del dominio generico de 90
# dias fijos de AnalyticsEvent/OutboxEvent). Filas PENDING/PROCESSING/RETRYABLE
# ("vivas") NUNCA son elegibles, sin importar su antiguedad. La duracion la
# fija la Politica de Privacidad / el titular legal, NUNCA ingenieria -- no
# hay valor por defecto.
# GOOGLE_PLAY_RTDN_RETENTION_DAYS_AFTER_TERMINAL=

# ENTITLEMENT -- Google Play reviewer grant (microbloque "PERSISTENT
# PRODUCTION REVIEWER GRANT"). `accountId` interno EXACTO de la cuenta
# dedicada de revision de Google Play -- resuelve esa cuenta a PREMIUM sin
# compra/AccountSubscription/RTDN. OPCIONAL, backend-only, nunca enviada al
# movil, nunca expuesta por ningun endpoint. AUSENTE / vacia -> sin efecto
# (fail-closed, ninguna cuenta recibe Premium por esto). NUNCA un email, un
# comodin ni un prefijo -- coincidencia exacta de un solo accountId. Ver
# EntitlementService.isReviewerGrantAccount.
# GOOGLE_PLAY_REVIEWER_ACCOUNT_ID=
