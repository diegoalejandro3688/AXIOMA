# Copiar a .env para desarrollo local (nunca commitear .env real).
# Ver ADR-0013.

EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# "stub" (default) usa StubIdentityClient -- sin proyecto Firebase real, sin
# red, sin bloquear el desarrollo (ver ADR-0013, Decision Gate 3). "firebase"
# activa FirebaseIdentityClient (requiere las 4 variables de abajo).
EXPO_PUBLIC_AUTH_IDENTITY_CLIENT=stub

# Solo necesarias si EXPO_PUBLIC_AUTH_IDENTITY_CLIENT=firebase.
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=

# ----------------------------------------------------------------------------
# ADS V1 (ADS-1B.1) -- modo de build de anuncios. INVARIANTE: en un build
# RELEASE, una variable OLVIDADA => SIN anuncios (ni de prueba ni de
# produccion). Solo el literal "true" activa algo. En __DEV__ (Metro/debug)
# se usan SIEMPRE los ids de prueba oficiales de Google; no hace falta nada.
#
# SMOKE QA (build release de prueba, p. ej. .adssmoke): ids de prueba de Google.
#   EXPO_PUBLIC_ADMOB_TEST_MODE=true
#   (NO definir EXPO_PUBLIC_ADMOB_PRODUCTION_IDS; ambas a la vez => SIN anuncios)
#   EXPO_PUBLIC_ADMOB_TEST_DEVICE_IDS=<id1,id2>   # opcional
#
# PRODUCTION RELEASE (solo ADS-1C en adelante, con los placements activos):
#   EXPO_PUBLIC_ADMOB_PRODUCTION_IDS=true
#   EXPO_PUBLIC_ADMOB_BANNER_HOME_ID=ca-app-pub-<16>/<10>
#   EXPO_PUBLIC_ADMOB_BANNER_STUDY_ID=ca-app-pub-<16>/<10>
#   EXPO_PUBLIC_ADMOB_BANNER_COMPETE_ID=ca-app-pub-<16>/<10>
#   EXPO_PUBLIC_ADMOB_INTERSTITIAL_QUICK_EXIT_ID=ca-app-pub-<16>/<10>
#   (NO definir EXPO_PUBLIC_ADMOB_TEST_MODE). Un id ausente/invalido/de prueba
#   => ese placement no se muestra. Los ids de unidad NO se versionan.
#
# El App ID de AdMob NO va aqui: es metadata publica del plugin en app.json.
# EXPO_PUBLIC_ADMOB_TEST_MODE=true
# EXPO_PUBLIC_ADMOB_TEST_DEVICE_IDS=
# EXPO_PUBLIC_ADMOB_PRODUCTION_IDS=true
# EXPO_PUBLIC_ADMOB_BANNER_HOME_ID=
# EXPO_PUBLIC_ADMOB_BANNER_STUDY_ID=
# EXPO_PUBLIC_ADMOB_BANNER_COMPETE_ID=
# EXPO_PUBLIC_ADMOB_INTERSTITIAL_QUICK_EXIT_ID=
