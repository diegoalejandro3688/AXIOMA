# Copiar a .env para desarrollo local (nunca commitear .env real).
# Ver ADR-0013.

EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# "stub" (default) usa StubIdentityClient -- sin proyecto Firebase real, sin
# red, sin bloquear el desarrollo (ver ADR-0013, Decision Gate 3). "firebase"
# activa FirebaseIdentityClient (requiere las 4 variables de abajo).
EXPO_PUBLIC_AUTH_IDENTITY_CLIENT=stub

# Solo necesarias si EXPO_PUBLIC_AUTH_IDENTITY_CLIENT=firebase.
# EXPO_PUBLIC_FIREBASE_API_KEY=
# EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
# EXPO_PUBLIC_FIREBASE_PROJECT_ID=
# EXPO_PUBLIC_FIREBASE_APP_ID=
